# Supabase PostgreSQL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# NextAuth
AUTH_SECRET="generate-with-npx-auth-secret"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Cron Secret
CRON_SECRET=""

# ── Anthropic: TWO KEYS, AND THEY ARE NOT INTERCHANGEABLE ─────────────
# See MDs/dev-vs-production-api-keys.md.

# PRODUCTION. Set on Vercel, and the only key name anything under src/
# reads. The Raspberry Pi bot does NOT need it: it has no Anthropic
# dependency and forwards over HTTP, so the model call happens on Vercel.
# Leave this OUT of a developer's local .env unless you are deliberately
# reproducing a production call.
ANTHROPIC_API_KEY=""

# DEVELOPMENT. Every harness, dry run and live sweep in this repo spends
# this one: scripts/dryrun-*.ts, scripts/measure-claimless.ts,
# scripts/chase-at-risk-live.ts, scripts/sim-onboarding.ts, the
# replay:router-* sweeps and any e2e run with MT_SIM_LIVE_LLM=1.
# They REFUSE to run without it and never fall back to the key above.
ANTHROPIC_API_KEY_DEV=""

# ── Self-join (MDs/self-join-and-approval-plan-2026-09-28.md) ──────────
# Off unless "1". With it off, /create-org is today's form.
SELF_JOIN_ENABLED=""
# MatchTime's own WhatsApp number, digits with country code. SERVER-ONLY:
# never give it a NEXT_PUBLIC_ name. It is shown only on a signed-in
# organiser's own club page (the "Add MatchTime to WhatsApp" link).
MATCHTIME_WA_NUMBER=""
# Who gets the ONE WhatsApp DM when a new club's group is linked and waits
# for approval (and the one-line ack after APPROVE / REJECT). Comma
# separated, with country code. Unset: nothing is DMed; use /admin/clubs.
SELF_JOIN_APPROVER_PHONES=""

# ── Club fee billing (MDs/club-fee-billing-plan-2026-10-01.md) ─────────
# Off unless "1". Off: nobody is billed or paused, the billing page and the
# settings card are hidden, the Add a card buttons are unreachable.
BILLING_ENABLED=""
# The club fee is charged by games played, in arrears (slice P2): the card
# is saved with Checkout in setup mode, and after each billing month ONE
# invoice is created on MatchTime's OWN (platform) account, the same
# account STRIPE_SECRET_KEY points at. No subscription, no price objects,
# no Customer Portal. It is kept apart from match fees (Connect direct
# charges, STRIPE_WEBHOOK_SECRET, /api/stripe/webhook). Use sk_test_ keys
# and test-mode ids until rollout. STRIPE_CLUB_PRICE_ID and
# STRIPE_CLUB_PORTAL_CONFIG_ID are retired (no longer read).
# REQUIRED: the "MatchTime club" product (prod_...), tax code
# txcd_10000000; every month's invoice item is made under it.
STRIPE_CLUB_PRODUCT_ID=""
# REQUIRED: the 20% UK VAT Tax Rate, INCLUSIVE (txr_...). A rate that is not
# inclusive makes the invoice total differ from the month's amount, and the
# month close then refuses to finalise it.
STRIPE_CLUB_TAX_RATE_ID=""
# Signing secret of the PLATFORM-scoped ("Your account") endpoint
# https://matchtime.ai/api/stripe/billing-webhook (whsec_...). NOT the
# Connect endpoint's STRIPE_WEBHOOK_SECRET. Unset: the route answers 503
# (Stripe retries) and changes nothing.
STRIPE_BILLING_WEBHOOK_SECRET=""
# Retries of a FAILED month's invoice: only ONE mechanism runs, normally
# Stripe's own (Settings > Billing > Revenue recovery > Retries, all within
# 7 days, e.g. days 1, 3 and 5; invoice left open after the last), confirmed
# in test mode to cover one-off invoices. Runbook: MDs/club-fee-billing-plan-
# 2026-10-01.md 16.1 steps 5 and 6.
# BILLING_STRIPE_RETRIES: "1" once the dashboard's retries are CHECKED on in
# this environment (the app cannot see the dashboard). OFF unless "1"/"true"/
# "on"/"yes": unset, the payment failed DM and the billing page never claim
# "it will be tried again" and say how to pay now instead.
BILLING_STRIPE_RETRIES=""
# BILLING_CRON_RETRIES: the hourly billing cron retries the invoice itself
# on days 1, 3 and 5 (daytime, card on file). OFF unless "1". Only for an
# account whose Stripe retries are off. Both on: the card is tried twice as
# often, and the billing cron warns on /admin/health.
BILLING_CRON_RETRIES=""
# TEST ONLY (the e2e suite sets it): with MT_TEST_MODE=1, a fake Stripe
# that never calls Stripe. Refused when a live key is present.
# BILLING_STRIPE_FAKE=""
