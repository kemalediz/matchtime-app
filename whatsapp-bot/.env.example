MATCHDAY_API_URL=https://matchday-nine-zeta.vercel.app
WHATSAPP_API_KEY=your-shared-secret-here
STATUS_INTERVAL_HOURS=4

# ── WhatsApp Web build pinning (optional) ────────────────────────────
# Leave all three UNSET for the default behaviour.
#
# whatsapp-web.js injects code against WhatsApp Web's minified internals.
# When WhatsApp ships a frontend change, those calls start throwing the
# minified `r: r` error and chat/contact lookups die. Pin a known-good
# build here and restart with scripts/deploy-pi.sh — no code deploy needed.
#
# Pick a build that EXISTS in the archive (it prunes old ones):
#   curl -sI https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/<VERSION>.html | head -1
#
# Full runbook: MDs/whatsapp-web-version-pinning.md
#WA_WEB_VERSION=2.3000.1046248368-alpha
#WA_WEB_VERSION_REMOTE_PATH=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/{version}.html
#WA_WEB_VERSION_CACHE_TYPE=none
