{
  "name": "matchtime-whatsapp-bot",
  "version": "1.0.0",
  "description": "WhatsApp bot for MatchTime attendance tracking",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/index.ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "test": "vitest run",
    "start:baileys": "node --env-file=.env --import tsx src/baileys/main.ts",
    "dev:baileys": "node --env-file=.env --import tsx --watch src/baileys/main.ts",
    "measure:group-phones": "node --env-file=.env --import tsx scripts/measure-group-phones.ts"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
