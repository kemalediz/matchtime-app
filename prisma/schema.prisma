generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  UPCOMING
  TEAMS_GENERATED
  TEAMS_PUBLISHED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  CONFIRMED
  BENCH
  DROPPED
}

enum Team {
  RED
  YELLOW
}

enum MemberRole {
  OWNER
  ADMIN
  PLAYER
}

// ─── NextAuth Adapter Tables ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Domain ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phoneNumber   String?   @unique
  // DROPPED 2026-09-19: `seedRating` and `matchRating` used to sit here.
  // They were GLOBAL, so one club's admin opinion and one club's Elo
  // followed a player into every other club he played for. Both live on
  // `Membership` now (see that model), backfilled for all 155
  // memberships on 2026-09-18 and sole source of truth since.
  // Slice 7 of MDs/club-scoped-ratings-design-2026-09-18.md.
  // DO NOT RE-ADD EITHER NAME TO THIS MODEL. A global rating column is
  // the bug, not the storage.
  // `src/lib/__tests__/no-global-rating-columns.test.ts` fails if one
  // comes back.
  isSuperadmin  Boolean   @default(false) // platform-level operator; see all orgs
  isActive      Boolean   @default(true)
  onboarded     Boolean   @default(false)

  /// Cross-club "nearby players" discoverability. Default OFF — a user is
  /// only surfaced to other groups after explicit opt-in. Scope is narrow:
  /// a coarse home-area point + radius, never a precise location, and no
  /// data here is shared until the user consents (discoverableConsentVer
  /// records which consent text they agreed to).
  discoverableNearby     Boolean   @default(false)
  discoverableNearbyAt   DateTime?
  discoverableConsentVer Int?
  nearbyRadiusKm         Int       @default(10)
  homeAreaLabel          String?
  homeAreaLat            Float?
  homeAreaLng            Float?

  accounts                Account[]
  sessions                Session[]
  badgeAnnouncements      BadgeAnnouncement[]
  memberships             Membership[]
  attendances             Attendance[]
  ratingsGiven            Rating[]                 @relation("RatingsGiven")
  ratingsReceived         Rating[]                 @relation("RatingsReceived")
  momVotesGiven           MoMVote[]                @relation("MoMVotesGiven")
  momVotesReceived        MoMVote[]                @relation("MoMVotesReceived")
  teamAssignments         TeamAssignment[]
  activityPositions       PlayerActivityPosition[]
  ratingAdjustments       RatingAdjustment[]
  aliases                 UserAlias[]
  rosterSurveyDMs         RosterSurveyDM[]
  rosterSurveyResponses   RosterSurveyResponse[]
  tentativeAvailabilities TentativeAvailability[]
  squadMonthMemberships   SquadMonthMember[]
  squadCredits            SquadCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organisation {
  id                 String  @id @default(cuid())
  name               String
  slug               String  @unique
  logo               String?
  inviteCode         String  @unique @default(cuid())
  whatsappGroupId    String?
  whatsappBotEnabled Boolean @default(false)

  /// ─── THE PARTICIPANT SWEEP'S OWN CLOCK (2026-09-09) ──────────────
  /// When a FULL READ of this group's WhatsApp participant list last
  /// succeeded. Exactly ONE writer: `importParticipants`, and only when
  /// it was handed a non-empty roster (an empty one is the sweep's
  /// QUIET failure mode, not a successful read of an empty group).
  ///
  /// This is the ONLY thing that licenses the inference "we have never
  /// seen this person, therefore they are not in the group". A null
  /// `Membership.lastSeenInGroupAt` is evidence of ABSENCE only when a
  /// working sweep could have looked and did not find them.
  ///
  /// WHY IT IS NOT `MAX(Membership.lastSeenInGroupAt)`, which is what
  /// the gate used until today: since 2026-09-09 an inbound group
  /// message also refreshes the SENDER's sighting (see
  /// `src/lib/group-sighting.ts`). That MAX would therefore be
  /// refreshed by any one chatty player and the org would read as
  /// healthy while the sweep was still dead — silently switching off
  /// the degraded mode that currently protects nine real Sutton
  /// players, the admin dashboard's banner, and the `sweep-stale`
  /// health alert, all at once. Per-person presence and sweep health
  /// are two different facts and now live in two different columns.
  ///
  /// Backfilled from `MAX(Membership.lastSeenInGroupAt)` per org by the
  /// migration, so behaviour is identical the instant it lands.
  lastParticipantSweepAt DateTime?

  /// ─── Lifecycle: is this club still a club? (2026-09-09) ─────────
  /// NULL = live. A timestamp = a human declared this organisation
  /// dormant on that date: the group is gone, the club has churned or
  /// disbanded, and MatchTime should stop acting on its own initiative
  /// for it. Data is deliberately RETAINED (that was the call for
  /// Sutton Lads, who churned 2026-06-18) — dormancy is the honest
  /// middle state between "live" and `deleteOrganisation`, which wipes
  /// everything.
  ///
  /// This exists because `whatsappBotEnabled` was being read as if it
  /// meant this, and it does not. That flag is a MUTE switch — Kemal
  /// muted the very-much-alive Sutton FC with it twice in the week of
  /// 2026-09-06 while doing engineering work, and the weekly fixture
  /// generator kept running for them, correctly. Gating anything
  /// lifecycle-shaped on the mute switch would mean an hour of
  /// engineering silently costs a live club its next squad.
  ///
  /// DECLARED, never inferred. A heuristic ("no attendance for N
  /// weeks") cannot tell a churned club from a club on a summer break,
  /// a winter break, or a venue closure, and the cost of guessing
  /// wrong is a squad that quietly never got created. See
  /// `src/lib/org-lifecycle.ts` for the full argument and the one
  /// place this is read.
  ///
  /// NOT the same axis as `Activity.isActive`, which stays exactly as
  /// it is: that is the per-FIXTURE switch (a format switch leaves the
  /// old format's Activity active on purpose), this is the per-CLUB
  /// one. Both are checked.
  dormantAt DateTime?

  /// The player who collects match fees on behalf of the group.
  /// Often a trusted long-serving member, not always the OWNER
  /// (e.g. Sutton FC — Kemal owns the org, Elvin collects payments).
  /// When non-null, this user is excluded from the "who hasn't paid"
  /// chase because they're the one being paid. Derived at onboarding
  /// by the LLM from chat patterns ("send me £7", "paid you back")
  /// and overridable in admin settings. Nullable — falls back to no
  /// exclusion if we can't determine.
  paymentHolderId String?

  /// Per-org flag: should the bot track who has paid and chase
  /// outstanding payments? When `true`, the daily 17:00 update
  /// includes the "💳 N payments still pending" tail, the LLM
  /// processes "X paid for N players" admin messages into
  /// PaymentCredit rows / Attendance.paidAt updates, and ticking
  /// the WA payment poll writes paidAt on the voter's Attendance.
  /// When `false`, the payment poll still posts at match-end (it's
  /// gated separately by Match.postMatchEndFlow) — but every other
  /// payment-tracking side-effect goes silent. Default OFF: orgs
  /// opt in to tracking. Sutton FC opted out 2026-04-29 because
  /// Elvin (the money taker) finds the chase overhead unnecessary
  /// and prefers tracking offline.
  paymentTrackingEnabled Boolean @default(false)

  /// Org-level override for the two team DISPLAY labels (lineups,
  /// score prompts, payment poll, match pages…). Index 0 maps to the
  /// canonical Team enum RED, index 1 to YELLOW — the enum itself
  /// never changes, only what we call the teams. Empty (default) or
  /// an empty-string slot falls back to the Sport's `teamLabels`,
  /// then to ["Red","Yellow"]. Resolved everywhere via
  /// `resolveTeamLabels()` in src/lib/team-labels.ts; editable by an
  /// org admin on /admin/settings.
  teamLabels String[] @default([])

  /// ─── The language this group is spoken to in (2026-09-16) ──────
  /// Lowercase ISO 639-1 code: "en" (default) or "tr". Read through
  /// `getOrgFeatures()` (src/lib/org-features.ts) and carried on
  /// `SquadState.features.language`, so every composer will have it
  /// with no extra query. Anything the code does not recognise is
  /// normalised to "en" by `normaliseLang` (src/lib/i18n/lang.ts), so a
  /// bad value can never produce a blank message.
  ///
  /// Per ORG, not per group or per player: an org has exactly one
  /// WhatsApp group (`whatsappGroupId`) and every scheduler job, DM and
  /// composer is already keyed on the org. A bilingual player in a
  /// Turkish group gets Turkish.
  ///
  /// Locale only, never timezone: every club plays in London and
  /// `src/lib/london-time.ts` stays hardcoded to Europe/London.
  ///
  /// Phase 0 of MDs/multi-language-design-2026-09-16.md: the column
  /// exists and is plumbed, and NO consumer changes its behaviour on it
  /// yet. Sutton FC reads "en" by the default and every English string
  /// is pinned byte for byte by src/lib/i18n/__tests__/copy-golden.test.ts.
  language String @default("en")

  /// ─── Per-feature module flags ───────────────────────────────────
  /// Each toggles one bot capability independently so a group can run
  /// only the bits it wants (Amir's Thursday group: MoM + rating
  /// only). Gated at every side-effect entry point via
  /// `getOrgFeatures()` in src/lib/org-features.ts.
  ///
  /// Default TRUE for the established behaviours so existing orgs
  /// (Sutton FC — live production) keep working unchanged on
  /// migration; new orgs get these set explicitly by the onboarding
  /// flow. Payment is the pre-existing `paymentTrackingEnabled`
  /// (default OFF, opt-in) — left as-is so its current gates and
  /// Sutton's opted-out state don't change.
  featureAttendance    Boolean @default(true) // IN/OUT tracking, squad list, chase, short-squad replies
  featureBench         Boolean @default(true) // bench prompts, fill-on-drop, bench-confirmation
  featureTeamBalancing Boolean @default(true) // generate_teams_request + the balancer
  featureMomVoting     Boolean @default(true) // MoM poll + 5-day announcement
  featurePlayerRating  Boolean @default(true) // post-match rating links/DMs
  featureReminders     Boolean @default(true) // @MatchTime personal reminder_request
  featureStatsQa       Boolean @default(true) // Recent-History stats answers

  /// "Squad from pasted list" mode (Amir's Thursday group shape, 2026-05-20).
  /// Some groups don't say IN/OUT — instead, every player copies the latest
  /// numbered squad message, appends their own line, and re-pastes the whole
  /// list. The bot derives the squad from the LATEST such list before kickoff
  /// (one LLM call per match over messages SINCE THE PREVIOUS MATCH ENDED;
  /// no per-batch analyzer). See `computeSinceForOrg` in squad-from-list.ts
  /// for the bootstrap + MAX_WINDOW_DAYS cap rules.
  ///
  /// Crucially, the bot also DIFFS each consecutive list against the previous
  /// one: the names added are attributed to that message's SENDER. When the
  /// sender's pushname matches one of the additions, that becomes a
  /// ground-truth UserAlias (e.g. ~T → "Tharan") — solving the nickname
  /// matching problem that letter-overlap fuzzy can never bridge.
  /// Other additions are signed-in guests (admin can fill in their phone
  /// later at /admin/players, same flow Sutton uses for any phone-less player).
  ///
  /// Default OFF (additive, no impact on Sutton). Auto-set TRUE at the end of
  /// onboarding for orgs that pick MoM and/or ratings but NOT attendance —
  /// i.e. groups that need a squad-of-record post-match (for MoM poll + rating
  /// DMs) but don't use the bot for in/out chatter.
  featureSquadFromList Boolean @default(false)

  /// Rolling squad (2026-09-30, slice 1 of
  /// MDs/friday-group-features-plan-2026-09-30.md): at 08:00 London the
  /// morning after a match, everyone who played it is written CONFIRMED
  /// on the next match of the same fixture. Default OFF; Sutton FC
  /// unchanged. Read through `OrgFeatures.rollingSquad`.
  rollingSquadEnabled Boolean @default(false)

  /// Badge announcements (2026-10-01, `badge-announcements.ts`): two days
  /// after each match, post the new badges in the group. Default ON, for
  /// new clubs and existing ones alike: a club's FIRST run can never post
  /// badges its players already held (the backfill plus the bootstrap
  /// guard, see that file). Read through `OrgFeatures.badgeAnnouncements`.
  featureBadgeAnnouncements Boolean @default(true)

  /// ─── Weekly deadlines (2026-09-30, slice 3 of
  /// MDs/friday-group-features-plan-2026-09-30.md) ────────────────────
  /// Club level (D8). Each pair is a London weekday (0=Sun..6=Sat) and
  /// wall-clock "HH:mm"; per match it resolves to the last occurrence
  /// strictly before kickoff (`weeklyDeadlinesFor`). All NULL by default:
  /// nothing changes until an admin sets them on /admin/settings.
  dropOutDeadlineDay  Int?
  dropOutDeadlineTime String?
  listPublishDay      Int?
  listPublishTime     String?

  /// ─── Stripe payments (2026-06-03) ───────────────────────────────
  /// Per-match fee collection. The money collector is `paymentHolderId`
  /// (surfaced as "Money collector" in org setup). The three methods
  /// below are independently toggleable; at least one must stay on when
  /// `paymentCollectionEnabled`. Surcharge-safe pricing: card is the
  /// standard (highest) price, pay-by-bank a discount, direct = base.
  /// Nothing here charges anyone until Stripe is connected AND
  /// paymentCollectionEnabled is true — fully gated, additive.
  paymentCollectionEnabled Boolean @default(false)
  /// Pay by Bank (open banking) — cheapest rail, the recommended default.
  payMethodPayByBank       Boolean @default(true)
  /// Card / Apple Pay / Google Pay — fallback rail.
  payMethodCard            Boolean @default(true)
  /// "Pay the collector directly" (cash/transfer) — honesty path, the
  /// collector confirms receipt. No processor fee.
  payMethodDirect          Boolean @default(true)
  /// The money collector's connected Stripe (Express) account id. Set
  /// when they complete the one-time bank onboarding. Null = not yet
  /// connected → Stripe rails unavailable, only "direct" can run.
  stripeConnectAccountId   String?
  /// True once Stripe reports the connected account can accept charges
  /// + receive payouts (onboarding fully complete).
  stripeChargesEnabled     Boolean @default(false)

  /// ─── The daily AI spend cap (2026-09-29) ───────────────────────
  /// The platform owner's per-club override, in US dollars per London
  /// calendar day. NULL (the default, and every club today) means the
  /// rule in `src/lib/ai-budget.ts`: $0.25 a day for the first four
  /// weeks, $1.00 a day after. Set it to lift or lower one club's cap.
  /// Read by `aiAllowanceUsd()`, the one place the cap is decided.
  aiDailyCapUsd   Float?
  /// When the club's first-four-weeks window starts. NULL means
  /// `createdAt`, which is every club today. It exists so the club
  /// approval flow (self-join, PR #138) can start the window at the
  /// moment a club is approved or goes live rather than when its row
  /// was created.
  aiWindowStartAt DateTime?

  /// ─── Club approval, for clubs that join themselves (2026-09-29) ──
  /// Plan: MDs/self-join-and-approval-plan-2026-09-28.md, slice 1.
  /// Values: "draft" | "pending" | "approved" | "rejected" | "suspended".
  /// The DEFAULT is "approved", so every club that existed before
  /// self-join (Sutton FC included) is approved by the migration and
  /// nothing changes for it. Only the self-join flow (later slices)
  /// creates a club in "draft".
  ///
  /// Silence is still enforced by `whatsappBotEnabled`; this column
  /// records WHY a club is off. A Postgres CHECK constraint
  /// (prisma/sql/org-approval-check.sql) forbids `whatsappBotEnabled`
  /// true on a club that is not approved, so no route that already
  /// requires the bot to be on can ever act for an unapproved group.
  ///
  /// Read through `src/lib/club-approval.ts` (`APPROVED_CLUB_WHERE`,
  /// `isClubOperational`); a source guard test keeps every write there.
  /// NOT the mute switch and NOT dormancy: `whatsappBotEnabled` and
  /// `dormantAt` keep their meanings.
  approvalStatus    String    @default("approved")
  /// When the club was approved. NULL for every club that existed
  /// before self-join. When set, it starts the new-club AI window
  /// (`aiAllowanceUsd` in src/lib/ai-budget.ts).
  approvedAt        DateTime?
  /// When, and by whom ("whatsapp:<phone>" or a userId), the last
  /// approval decision was made.
  approvalDecidedAt DateTime?
  approvalDecidedBy String?

  /// ─── Admin channel (2026-09-30, slice 2a) ─────────────────────────
  /// Plan: MDs/friday-group-features-plan-2026-09-30.md, section 2.2 to 2.5.
  /// Where admin-only notices go: "one-person" | "admin-group" | "each-admin".
  /// New clubs start on "one-person" (the owner). The migration filled
  /// every club that existed before it with "each-admin", today's
  /// behaviour, so Sutton FC's notices, texts and keys are unchanged.
  /// Read only through `src/lib/admin-channel.ts` (`sendAdminNotice`).
  adminChannelMode            String    @default("one-person")
  /// "one-person": who. NULL = the owner.
  adminChannelUserId          String?
  /// The linked admin WhatsApp group. One club per group; never the
  /// club's own community group (CHECK constraint, see the migration).
  adminGroupId                String?   @unique
  adminGroupSubject           String?
  adminGroupLinkedAt          DateTime?
  adminGroupLinkedByUserId    String?
  /// The pending link code shown on the settings page. Single use,
  /// cleared when a group is linked. Unique across clubs.
  adminGroupLinkCode          String?   @unique
  adminGroupLinkCodeExpiresAt DateTime?

  /// ─── Organiser pick (2026-10-01, slice 2b) ────────────────────────
  /// Plan: MDs/friday-group-features-plan-2026-09-30.md, sections 2.6 to 2.13.
  /// Who fills an open place: "first-come" (today, default) or
  /// "organiser" (MatchTime never fills a place by itself; the admins
  /// pick from the waiting list). Sutton FC and every existing club read
  /// "first-come", so nothing changes for them.
  benchPickMode     String @default("first-come")
  /// When no admin picks in time: "bench-offer" (default, D5: offer the
  /// place to the whole waiting list, first to say IN) or "leave-empty".
  benchPickFallback String @default("bench-offer")

  /// ─── Club fee billing (2026-10-01, slice B1) ──────────────────────
  /// Plan: MDs/club-fee-billing-plan-2026-10-01.md, sections 3 and 4.
  /// "exempt" | "trial" | "grace" | "subscribed" | "past_due" | "paused".
  /// DEFAULT "exempt": every club that exists when this lands (Sutton FC
  /// included) is never billed and never paused. Only an approval with
  /// BILLING_ENABLED on moves a club to "trial" (slice B2). Single writer:
  /// `setBillingState` in src/lib/club-billing.ts (source guard test).
  /// A GATE: "paused" makes MatchTime quiet for the club (no posts, no
  /// replies, no AI), read through `servingClubWhere` / `isClubOperational`
  /// in club-approval-state.ts, and ignored entirely while BILLING_ENABLED
  /// is off. NOT the mute switch: `whatsappBotEnabled` is never written by
  /// billing. CHECK constraints: prisma/sql/org-billing-check.sql.
  billingStatus     String @default("exempt")
  /// "standard" | "free" | "custom". Set by the platform owner (slice B2).
  billingPlan       String @default("standard")
  /// Monthly price in pence when billingPlan = "custom" (100 to 999). NULL otherwise.
  billingPricePence Int?

  /// ─── Learned setup, F3 (2026-10-05) ───────────────────────────────
  /// The settings the organiser has saved on /admin/settings (the keys of
  /// `setWeeklyRoutine`, `setOrgFeature` and `setOrgLanguage`, plus any
  /// learned setting they undid). The learned setup never changes a key
  /// listed here. May hold duplicates; readers treat it as a set.
  settingsSetByOrganiser String[] @default([])

  /// ─── Monthly squad (2026-10-05, slice 2) ──────────────────────────
  /// Plan: MDs/monthly-squad-plan-2026-10-05.md, section 3.
  /// How the club's squad works: "weekly" (today, the default for every
  /// club, Sutton FC included) or "monthly" (regulars commit and pay for
  /// the month, PAYG players fill the gaps). Switched on /admin/settings
  /// by an OWNER or ADMIN (D6), never automatically. Read through
  /// `OrgFeatures.squadMode`; "monthly" also reads the rolling squad as
  /// off. CHECK constraint: prisma/sql/monthly-squad-check.sql.
  squadMode                String  @default("weekly")
  /// Default PAYG price per game, in pence (800 = £8). NULL = not set.
  paygPricePence           Int?
  /// "List for <Month>" is posted this many days before the month's first
  /// game (slice 3 reads it; nothing posts in slice 2).
  monthListOpensDaysBefore Int     @default(7)
  /// Which misses earn a paid regular a credit (D2): "any-miss" (default),
  /// "filled-only" or "none".
  monthCreditRule          String  @default("any-miss")
  /// The collector's own free text, shown with the month's amounts
  /// ("bank details are in the group description"). MatchTime never asks
  /// for account numbers and never reads this as anything but text.
  paymentInstructions      String?

  memberships        Membership[]
  clubConnects       ClubConnect[]
  activities         Activity[]
  sports             Sport[]
  userAliases        UserAlias[]
  rosterSurveys      RosterSurvey[]
  groupMessages      GroupMessage[]
  windowVerdicts     WindowVerdict[]
  badgeAnnouncements BadgeAnnouncement[]
  clubBilling        ClubBilling?
  setupLearning      ClubSetupLearning?
  billingNotices     BillingNotice[]
  billingMonths      ClubBillingMonth[]
  squadMonths        SquadMonth[]
  squadCredits       SquadCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Phase 2 — autonomous in-group onboarding. When a moderator types
 * "@MatchTime setup" in a group with no org, the bot runs a
 * conversational setup IN THE GROUP (anyone can answer): gather the
 * event details, then the feature menu, then create
 * Sport/Activity/Match + flip the Phase-1 feature flags.
 * One active row per WhatsApp group. `stage` drives the LLM's next
 * question; collected answers accumulate as we go. orgId is filled in
 * once we provision the Organisation (at "features" stage, so the
 * group becomes monitored normally). `selectedFeatures` holds the
 * FeatureKey strings the group chose.
 */
model OnboardingSession {
  id              String  @id @default(cuid())
  whatsappGroupId String
  /// Filled once the Organisation is provisioned (features stage).
  orgId           String?
  /// "collecting" → asking event questions (legacy "@MatchTime setup" flow)
  /// "features"   → org created, asking which features to enable (legacy flow)
  /// "introduced" → bot was ADDED to the group and posted its intro; waiting
  ///                for a YES/EVERYTHING/named-features consent reply
  ///                (group-add flow, Phase 1 autonomous onboarding)
  /// "admins"     → consent given, owner captured; asking "who else helps
  ///                run this group?" to capture additional admins
  ///                (group-add flow, Phase 1 autonomous onboarding)
  /// "details"    → admins captured; asking the one combined
  ///                "when & where do you play?" question (group-add flow)
  /// "completed"  → Activity/Match created, flags set, normal ops
  /// "dormant"    → nobody consented after the intro; bot stays silent
  /// "abandoned"  → admin/cron cleaned up a stale session
  stage           String  @default("collecting")

  /// How this session started: "setup-trigger" (legacy "@MatchTime setup"),
  /// "group-add" (bot detected being added to the group), or
  /// "dashboard-pair" (Phase 2, reserved).
  source        String    @default("setup-trigger")
  /// WhatsApp group subject at the moment the bot was added — used as the
  /// club name so we never ask a question we already know the answer to.
  groupSubject  String?
  /// E.164 phone of whoever added the bot to the group (fallback admin
  /// candidate when the consent replier has no resolvable phone).
  addedByPhone  String?
  /// Captured admin (User.id) — the YES/EVERYTHING replier. Becomes the
  /// org OWNER at completion.
  adminUserId   String?
  /// Participant snapshot at add time: [{phone?, lidId?, pushname?}].
  /// Imported into the org roster at completion so the admin never types
  /// a player in by hand.
  participants  Json?
  /// 24h "still here" re-nudge idempotency (group-add flow, Phase 1 cron
  /// sweep — reserved; written by the nudge when it ships).
  introNudgedAt DateTime?
  /// The language this setup conversation is held in (2026-09-17):
  /// detected from the group subject and synced history when the bot is
  /// added, corrected by the consent reply ("evet" / "yes"), and copied
  /// onto Organisation.language at completion. Lowercase ISO 639-1.
  language      String    @default("en")
  /// Additional admins parsed at the "admins" stage (group-add flow):
  /// [{name?, phone?, mention?}]. Stashed here because the Organisation
  /// doesn't exist yet at that stage; resolved into ADMIN Memberships at
  /// completion. null/[] = just the owner.
  pendingAdmins Json?

  // Collected event details (nullable until answered).
  groupName      String?
  venue          String?
  dayOfWeek      Int? // 0=Sun..6=Sat
  kickoffTime    String? // "21:30" (London wall clock)
  playersPerSide Int? // 7 → 7-a-side
  recurrence     String? // "weekly" | "oneoff"
  oneOffDate     String? // ISO date when recurrence = oneoff

  selectedFeatures String[]

  /// Last waMessageId we replied to — dedupe so a re-flushed batch
  /// doesn't re-ask the same question.
  lastHandledWaId String?

  // ── Onboarding enrichment (Phase: chat-history analysis) ──────────────
  /// Lifecycle of the post-onboarding enrichment pass that mines chat
  /// history for player positions, seed ratings and the match schedule.
  /// null | "pending" | "ready" | "applied".
  enrichmentStatus    String?
  /// When the admin applied the proposed roster to live records.
  enrichmentAppliedAt DateTime?
  /// How many recent messages the analyser actually saw.
  messagesAnalyzed    Int?
  /// Proposed roster from the analyser, reconciled against members:
  /// [{ name, matchedUserId?, proposedPosition?, proposedSeedRating?(1-10),
  ///    evidence, confidence }].
  proposedRoster      Json?
  /// Members with no resolvable phone — rating/positions are meaningless
  /// until a phone is added: [{ name, lidId? }].
  unresolvedMembers   Json?
  /// Best-guess match schedule mined from the chat:
  /// { dayOfWeek?, time?, venue?, playersPerSide?, capacity? }.
  capturedSchedule    Json?
  /// Chat history captured by the Pi bot shortly AFTER the bot was added
  /// (it can only fetch WhatsApp history around join time, but enrichment
  /// runs later at completion). Shape: [{author, authorPhone?, text,
  /// timestamp}] — the HistoryMessage shape consumed by completeOnboarding/
  /// runOnboardingEnrichment. Persisted at bot-added; read as the fallback
  /// at completion when the completing /analyze request omits its own
  /// enrichmentHistory. null = none captured → no enrichment (unchanged).
  capturedHistory     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappGroupId, stage])
}

model Sport {
  id                  String       @id @default(cuid())
  orgId               String
  org                 Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String // "Football 7-a-side"
  preset              String? // "football-7aside" | "basketball-5v5" | null for custom
  playersPerTeam      Int
  positions           String[] // ["GK","DEF","MID","FWD"]
  teamLabels          String[] // ["Red","Yellow"]
  mvpLabel            String       @default("Man of the Match")
  balancingStrategy   String       @default("position-aware") // "position-aware" | "rating-only"
  positionComposition Json? // { GK: 1, DEF: 2, MID: 2, FWD: 2 } — per-team target

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role   MemberRole   @default(PLAYER)

  /// Non-null when the user has been detected as leaving the org's
  /// WhatsApp group (bot `group_leave` event) or been manually removed
  /// by an admin. We keep the membership row for history (so past
  /// attendances/ratings stay attributable) — just exclude "left" rows
  /// from roster queries. A `group_join` later will null this back out.
  leftAt DateTime?

  /// Non-null when this membership was auto-created by the analyzer
  /// because an unknown sender posted in the org's monitored group.
  /// The admin dashboard surfaces these so owners can fill in phone,
  /// position, seed rating, or remove them if they're not a player.
  /// Cleared once an admin edits the player (confirming they're real).
  provisionallyAddedAt DateTime?

  /// Last time the bot saw this user in the org's WhatsApp group
  /// participant list (via /api/whatsapp/sync-participants on bot
  /// startup). Used to scope DM-blast features (roster check-in
  /// survey) to only members currently in the group, per Kemal's
  /// "don't message people who already left" rule. Null = never seen
  /// in a sync (could be pre-sync legacy member, or genuinely gone).
  lastSeenInGroupAt DateTime?

  /// @deprecated 2026-07-17 — SUPERSEDED by `subRatingDm` (inverted
  /// semantics: subRatingDm=true means subscribed). No longer read or
  /// written anywhere in the app; kept only so we don't drop a column on
  /// a live DB in the same PR that introduced the replacement. The data
  /// migration backfilled `subRatingDm = NOT ratingDmOptOut`, so this
  /// column's meaning is fully preserved in the new one. Safe to DROP in
  /// a later, dedicated migration once the backfill is confirmed in prod.
  ratingDmOptOut   Boolean   @default(false)
  ratingDmOptOutAt DateTime?

  /// ─── Per-category proactive-DM subscriptions (2026-07-17) ───────────
  /// Every member is subscribed to ALL proactive-DM categories by default
  /// (true = subscribed = receives). A player can unsubscribe from any
  /// subset by DM'ing the bot — see the keyword fast-path in
  /// `/api/whatsapp/dm-reply` and `setDmSubscriptions` in
  /// `src/lib/notification-prefs.ts`. Flags apply across ALL of a user's
  /// active (non-left) memberships (a preference is about the human, not
  /// one club). Born from a real incident (2026-07-17): a player asked to
  /// only be messaged about payments; the old single `ratingDmOptOut`
  /// silenced ratings but let recruit/bench/reminder DMs through, so the
  /// bot effectively lied. These give the player real per-category control.
  ///
  /// PAYMENT DMs deliberately have NO flag here: a player who owes money is
  /// always sent their pay link + chases regardless of every flag below.
  subMatchInviteDm Boolean @default(true) // recruit / squad-fill invites (src/lib/recruit.ts)
  subBenchOfferDm  Boolean @default(true) // bench-slot offers (bot-scheduler)
  subTentativeDm   Boolean @default(true) // tentative-availability follow-up DM
  subRatingDm      Boolean @default(true) // rating DM + daily rating reminder + MoM DMs (supersedes ratingDmOptOut)
  subReminderDm    Boolean @default(true) // user-requested "@MatchTime remind me" DMs

  /// Last time any of the sub* flags above was changed (audit). Null =
  /// never touched since creation (still on all defaults).
  subPrefsUpdatedAt DateTime?

  /// PER-CLUB RATING STATE (2026-09-18)
  /// Moved off User, where both of these were global. A player in two
  /// clubs had one seed and one Elo doing duty for both; see
  /// MDs/club-scoped-ratings-design-2026-09-18.md section 3.5 for what
  /// that was costing Sutton FC. Nothing reads these yet: slice 1 lands
  /// the columns and the backfill, slice 2 onward moves the readers.
  ///
  /// This club's admin opinion of the player, 1 to 10. NULL means the
  /// club has no opinion yet, which is the correct state for a new
  /// member: the blend then shrinks toward the CLUB's own mean rating,
  /// never toward another club's number and never toward the overall.
  /// Do NOT default this. A default is a carried-over opinion.
  seedRating Float?

  /// This club's Elo. Leaderboard only (see lib/elo.ts). 1000 is the
  /// genuine "no information" value for Elo, so unlike seedRating it
  /// keeps a default.
  matchRating Int @default(1000)

  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([leftAt])
}

/// GLOBAL (not org-scoped) registry of physical venues, deduped by Google
/// Place ID (placeId). Shared across all groups so two clubs playing at the
/// same pitch resolve to one row — the backbone of "nearby players".
/// Contains no personal data.
model Venue {
  id               String     @id @default(cuid())
  placeId          String?    @unique
  name             String
  formattedAddress String?
  lat              Float?
  lng              Float?
  source           String?
  activities       Activity[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Activity {
  id                String       @id @default(cuid())
  orgId             String
  org               Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sportId           String
  sport             Sport        @relation(fields: [sportId], references: [id])
  name              String
  dayOfWeek         Int // 0=Sun..6=Sat
  time              String // "21:30"
  venue             String
  venueId           String?
  venueRef          Venue?       @relation(fields: [venueId], references: [id])
  isActive          Boolean      @default(true)
  deadlineHours     Int          @default(5)
  matchDurationMins Int          @default(60)
  ratingWindowHours Int          @default(120) // 5 days — aligns with MoM announcement & magic-link TTL

  /// Default per-player match fee (£) for this activity/format. The
  /// 5-a-side and 7-a-side activities each carry their own, so a format
  /// switch auto-applies the right fee. Null = no default; the collector
  /// is asked each week. This is the BASE fee (before the per-method
  /// processing uplift). 2026-06-03.
  feePerPlayer  Float?
  /// When true, the collector enters the TOTAL pitch cost and MatchTime
  /// divides by who played, instead of a fixed per-player fee.
  feeSplitTotal Boolean @default(false)

  matches         Match[]
  playerPositions PlayerActivityPosition[]
  blockBookings   BlockBooking[]
  squadMonths     SquadMonth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([sportId])
  @@index([venueId])
}

/**
 * A venue BLOCK BOOKING (2026-07-20). Sutton FC's real-world shape: the
 * club pays the venue for N consecutive weekly matches up-front (e.g. 10
 * Tuesdays, 25 Aug → 27 Oct 2026). All Match rows are created UP-FRONT at
 * block creation so the whole season is visible and manageable as a set
 * (list, bulk-cancel for holidays, bulk-restore, delete).
 * Posting semantics are unchanged: the scheduler's
 * `isNextUpcomingForPosting` gate (src/lib/next-upcoming-match.ts) already
 * suppresses any match with an earlier LIVE match in the same recurring
 * fixture, so pre-created future matches stay silent until the previous
 * one is COMPLETED or CANCELLED. Creating a block queues no group post.
 * `time` is a LONDON WALL CLOCK "HH:mm"; each match's UTC instant is
 * resolved PER DATE (DST-safe — the 2026 block straddles the BST→GMT
 * change). `startDate`/`endDate` are London calendar dates (DATE column,
 * read back as UTC midnight).
 * Deleting a block never deletes played/history-bearing matches — they are
 * detached (Match.blockBookingId → NULL via ON DELETE SET NULL after the
 * explicit partition in deleteBlockBooking).
 */
model BlockBooking {
  id           String   @id @default(cuid())
  orgId        String
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id])
  /// First match calendar date (London), inclusive.
  startDate    DateTime @db.Date
  /// Last match calendar date (London), inclusive.
  endDate      DateTime @db.Date
  /// Kickoff, London wall clock "HH:mm" — resolved to UTC per date.
  time         String
  /// What the venue charges per match (£). Optional bookkeeping.
  costPerMatch Float?
  notes        String?

  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([activityId])
}

model PlayerActivityPosition {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  positions  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, activityId])
  @@index([activityId])
}

model Match {
  id                 String      @id @default(cuid())
  activityId         String
  activity           Activity    @relation(fields: [activityId], references: [id])
  date               DateTime
  maxPlayers         Int
  status             MatchStatus @default(UPCOMING)
  attendanceDeadline DateTime
  redScore           Int?
  yellowScore        Int?
  /// When false, the bot skips match-end postings (payment poll, rating-link DMs,
  /// MoM announcement, rating-reminder DMs) for this specific match. Useful for
  /// the first match after launch while the rating UI is still maturing.
  postMatchEndFlow   Boolean     @default(true)

  /// Set when this match was generated as part of a venue block booking
  /// (see BlockBooking). Lets a block be listed/bulk-cancelled/deleted as
  /// a set. Nullable + SetNull on block deletion = additive, zero impact
  /// on existing rows and on the weekly cron's matches.
  blockBookingId String?
  blockBooking   BlockBooking? @relation(fields: [blockBookingId], references: [id], onDelete: SetNull)

  /// Synthetic historical match — NOT a real scheduled match, just an
  /// anchor for pre-MatchTime MoM votes we backfilled from WhatsApp
  /// chat history. Dashboards, the bot scheduler, and "recent results"
  /// lists all exclude these so they don't pollute present-day UX.
  /// The leaderboard's MoM-count query DOES include them — which is
  /// the whole point of backfilling.
  isHistorical Boolean @default(false)

  /// ─── Per-match fee capture (2026-06-03) ─────────────────────────
  /// The agreed per-player fee for THIS match (£, base before method
  /// uplift). Set when the money collector tells MatchTime the amount
  /// (chat capture) or from the activity default. Null = not set yet.
  feePerPlayer           Float?
  /// Amount the collector proposed but hasn't confirmed yet — MatchTime
  /// echoes it back and waits for ✅ before releasing links.
  feePendingConfirm      Float?
  /// Who set the fee + when (audit).
  feeSetByUserId         String?
  feeSetAt               DateTime?
  /// Set when the per-player payment-link DMs have gone out. Null = not
  /// released yet (fee not confirmed). Gates the chaser.
  paymentLinksReleasedAt DateTime?

  /// Rolling squad (2026-09-30): when last week's squad was copied onto
  /// this match. NULL = never. Written once, by the claim in
  /// `seedRollingSquad` (src/lib/rolling-squad.ts); it is the idempotency
  /// key, so a second cron tick or the admin button seeds nothing twice.
  rollingSeededAt          DateTime?
  /// The match the squad was copied from. Plain string, no FK (history).
  rollingSeededFromMatchId String?

  /// Per-match display-label override (highest precedence over org/sport).
  /// Index 0 = RED, 1 = YELLOW. Set when an admin asks MatchTime to invent
  /// fun team names for this week's match. Empty (default) = fall through to
  /// org/sport/default via resolveTeamLabels().
  teamLabels String[] @default([])

  attendances             Attendance[]
  teamAssignments         TeamAssignment[]
  ratings                 Rating[]
  momVotes                MoMVote[]
  sentNotifications       SentNotification[]
  benchConfirmations      PendingBenchConfirmation[]
  benchSlotOffers         BenchSlotOffer[]
  ratingAdjustments       RatingAdjustment[]
  paymentCredits          PaymentCredit[]
  tentativeAvailabilities TentativeAvailability[]
  organiserPickRounds     OrganiserPickRound[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([blockBookingId])
}

/**
 * Every WhatsApp-bot message the scheduler asks the bot to send is logged
 * here with a stable key so it doesn't fire twice. Keys look like
 * "<matchId>:<kind>" (group-wide events) or "<matchId>:<kind>:<userId>"
 * (per-user DMs / reminders).
 */
/**
 * Badge announcements (2026-10-01): the ledger of badges MatchTime has
 * announced in a club's group, ONE row per player per badge per club,
 * ever (the unique key is the whole guarantee). Written in the same
 * transaction that claims the `<matchId>:badges` post, plus silent rows
 * for badges a player already held before the feature reached the club
 * (the backfill script and the bootstrap guard, `badge-announcements.ts`).
 * `matchId` is the match the badge was earned at: informational only,
 * with no foreign key, so deleting a match never forgets an announcement.
 */
model BadgeAnnouncement {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey  String
  matchId   String?
  createdAt DateTime     @default(now())

  @@unique([orgId, userId, badgeKey])
}

/// Club fee billing (2026-10-01, slice B1): the Stripe details of one
/// billed club. Plan: MDs/club-fee-billing-plan-2026-10-01.md, 3.2.
/// Created when a club's free month starts (slice B2); an exempt club has
/// no row. `trialEndsAt` is written ONCE and never reset, so a club gets
/// one free month, re-approval included. Written only by
/// src/lib/club-billing.ts. No card numbers are ever stored.
model ClubBilling {
  orgId                    String       @id
  org                      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  trialStartedAt           DateTime
  trialEndsAt              DateTime
  /// trialEndsAt + 7 days (no card), or paymentFailedAt + 7 days.
  graceEndsAt              DateTime?
  stripeCustomerId         String?      @unique
  stripeSubscriptionId     String?      @unique
  /// Stripe's own word: trialing, active, past_due, canceled, unpaid ...
  stripeSubscriptionStatus String?
  stripePriceId            String?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean      @default(false)
  stripePaymentMethodId    String?
  cardBrand                String?
  cardLast4                String?
  /// Who added the card on file (the money collector, or the owner).
  cardHolderUserId         String?
  paymentFailedAt          DateTime?
  pausedAt                 DateTime?
  /// "no-card" | "payment-failed" | "cancelled" | "removed"
  pausedReason             String?
  billingCountry           String?
  cardCountry              String?
  vatCountryCheck          Boolean      @default(false)
  resumedAt                DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

/// Stripe billing webhook idempotency and audit (slice B3 writes it).
/// `id` is Stripe's event id. No foreign key on purpose: the audit row
/// outlives a deleted club.
model BillingEvent {
  id          String    @id
  type        String
  orgId       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?   @db.Text

  @@index([orgId, receivedAt])
}

/// One billing DM per club, per kind, per cycle (slice B4 writes it).
/// Insert first, then queue the DM, so a retried cron or a re-delivered
/// webhook can never DM twice about the same thing.
model BillingNotice {
  id            String       @id @default(cuid())
  orgId         String
  org           Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// "trial-21" | "trial-28" | "trial-ended" | "paused" | "card-added" |
  /// "payment-failed" | "payment-action" | "resumed" | "plan-billed" |
  /// "payer-changed" | "card-replaced" | "fee-tip" | "month-charged" |
  /// "month-free" | "keep-paying" (no CHECK: a free-text column)
  kind          String
  cycleKey      String
  platformJobId String?
  createdAt     DateTime     @default(now())

  @@unique([orgId, kind, cycleKey])
}

/// One billing month of a billed club, charged by games played in arrears
/// (slice P1, 2026-10-04). Plan: MDs/club-fee-billing-plan-2026-10-01.md,
/// sections 2A and 3.6. Opened by the billing cron when the month starts,
/// closed the morning after it ends (P2/P3). Single writer (from P2):
/// src/lib/club-billing-months.ts. P1 adds the table only; nothing writes
/// it yet. CHECK constraints: prisma/sql/club-billing-month-check.sql.
model ClubBillingMonth {
  id                String       @id @default(cuid())
  orgId             String
  org               Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// 1 = the first month after the free month.
  index             Int
  startsAt          DateTime
  /// Exclusive: 00:00 London on the anchor day of the next month.
  endsAt            DateTime
  /// The plan's monthly maximum when the month opened (pence).
  priceAtStartPence Int
  /// "open" | "closing" | "no-games" | "below-minimum" | "waived" | "no-card"
  /// | "invoiced" | "paid" | "failed" | "void"
  status            String       @default("open")
  scheduled         Int?
  played            Int?
  /// The maximum used: the lower of the price at start and at close.
  pricePence        Int?
  amountPence       Int?
  /// Why it was waived ("free-plan" | "suspended" | "removed-before-start" ...).
  reason            String?
  /// The games counted: one entry per scheduled game, with its match ids,
  /// kickoff, played or not and why. For the receipt page and any dispute.
  games             Json?
  stripeInvoiceId   String?      @unique
  closedAt          DateTime?
  paidAt            DateTime?
  refundedPence     Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([orgId, index])
  @@index([status])
}

model SentNotification {
  id          String   @id @default(cuid())
  key         String   @unique
  kind        String // e.g. "announce-match", "daily-in-list", "match-teams", ...
  matchId     String?
  match       Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  targetUser  String? // userId when it's a per-user DM
  waMessageId String? // WhatsApp message id for reaction tracking
  createdAt   DateTime @default(now())

  @@index([matchId])
  @@index([kind])
}

/**
 * Ad-hoc queue for bot work the scheduler should dispatch on its next
 * tick. Used for one-off admin actions (e.g. "send a test DM to Kemal")
 * that don't map onto the regular match-lifecycle triggers. Scheduler
 * picks up rows with `sentAt == null`, emits matching instructions, and
 * marks `sentAt` on ACK so they don't repeat.
 */
/**
 * Short-lived one-time passcodes used by the phone-number signup flow.
 * Owner delivers codes via WhatsApp DM (using the shared MatchTime
 * bot) and verifies them at /signup/verify.
 * Rate-limiting: we keep rows around past usedAt/expiresAt briefly to
 * throttle resends — a separate sweep drops them after 24h.
 */
model PhoneOtp {
  id        String    @id @default(cuid())
  /// Normalised phone number (no "+" prefix; purely digits).
  phone     String
  code      String // 6 digits, zero-padded
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  /// The requesting client's IP (first `x-forwarded-for` hop), for the
  /// per-IP sign-up cap (self-join plan section 7, cap 3). NULL for codes
  /// issued before 2026-09-29, for claim-account codes, and whenever the
  /// request carried no forwarding header.
  requestIp String?

  @@index([phone, createdAt])
  @@index([requestIp, createdAt])
  @@index([createdAt])
}

/**
 * Roster check-in survey. An admin triggers one when attendance has
 * been thin and they want to know who's still committed. The bot
 * DMs every active member; replies are LLM-classified into
 * in/maybe/out/unclear; admins read raw replies + override on the
 * dashboard.
 * Lifecycle: status="open" while DMs are out and replies trickle in.
 * Once admin closes it (or after a manual cleanup pass), status="closed"
 * — daily group updates stop, no more replies are accepted.
 */
model RosterSurvey {
  id           String       @id @default(cuid())
  orgId        String
  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sentByUserId String // admin who triggered
  status       String       @default("open") // "open" | "closed"
  closedAt     DateTime?
  closedById   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  dms       RosterSurveyDM[]
  responses RosterSurveyResponse[]

  @@index([orgId, status])
}

/// One row per surveyed member — tracks the outbound DM. `sentAt`
/// fills in when the bot ACKs delivery; `failedReason` populated if
/// WhatsApp rejected the DM (e.g. number blocked the bot or doesn't
/// have an account). Admin dashboard uses this to show "pending"
/// (no Response yet) vs "delivery failed".
model RosterSurveyDM {
  id           String       @id @default(cuid())
  surveyId     String
  survey       RosterSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  botJobId     String?
  sentAt       DateTime?
  failedReason String?
  createdAt    DateTime     @default(now())

  @@unique([surveyId, userId])
  @@index([surveyId])
}

/// One row per (survey, user) — latest reply wins (upsert on each
/// new DM from the same user). `rawReply` is the verbatim text the
/// user sent so the admin can read it on the dashboard. `response`
/// is the LLM's classification; `adminOverride=true` means an admin
/// changed it manually and the LLM shouldn't re-flip it.
model RosterSurveyResponse {
  id            String       @id @default(cuid())
  surveyId      String
  survey        RosterSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  response      String // "in" | "maybe" | "out" | "unclear"
  rawReply      String       @db.Text
  classifiedAt  DateTime     @default(now())
  adminOverride Boolean      @default(false)

  @@unique([surveyId, userId])
  @@index([surveyId])
}

/**
 * The WhatsApp bot's latest self-report, one row per org.
 * Everything the bot knows about its own health used to be a
 * `console.error` in `bot.log` on a Raspberry Pi that nobody reads — the
 * 2026-08-30 audit's headline finding, and the reason a three-day outage
 * was a three-day outage. This is where that signal lands instead.
 * LATEST-ONLY, not a history table. The counters are cumulative per bot
 * PROCESS, so every rule in `src/lib/bot-health.ts` is expressible as
 * "has this ever happened since the process started" and needs no deltas.
 * One row per org means no growth, no retention cron, and no second place
 * for the truth to live. `processStartedAt` is what tells a reader the
 * counters reset.
 * Written by `POST /api/whatsapp/heartbeat` (every ~10 min, from the
 * Pi's batch-flush timer, INCLUDING the tick where there was nothing to
 * flush — an empty buffer is the failure being hunted, so the report
 * cannot be conditional on having something to say). Read by
 * `GET /api/cron/bot-health` hourly, which is the half that notices
 * ABSENCE: a Pi that sends nothing cannot report that it sent nothing.
 * No relation to Organisation, matching `BotJob` next door: this is
 * operational telemetry, not domain data, and it must survive being
 * looked at when the org row is mid-edit.
 */
model BotHealth {
  id        String  @id @default(cuid())
  orgId     String  @unique
  /// The WhatsApp group the reporting bot was monitoring for this org.
  /// Null until a heartbeat has actually arrived.
  waGroupId String?

  /// When the Pi last reported. ABSENCE of a fresh value here is the
  /// signal that catches a dead Pi, and it is the only signal that can.
  ///
  /// NULLABLE, and the distinction is load-bearing: null means "no
  /// heartbeat has EVER arrived", which is what a healthy Pi running a
  /// build older than 2026-09-09 looks like, and it must never be read
  /// as an outage. A row can exist with this still null because the
  /// server-side alert rules (stale sweep, nameless senders) fire off
  /// data an older Pi already produces, and their dedupe state lives
  /// here. Storing a sentinel date instead would make every such org
  /// look permanently dead.
  lastHeartbeatAt  DateTime?
  /// When the reporting bot process started. Counters are per-process,
  /// so a change here means they reset (and is itself evidence of a
  /// restart loop when it keeps changing).
  processStartedAt DateTime?
  /// Free-form build marker from the Pi, for "which build is running".
  botVersion       String?

  /// Cumulative per-process inbound counters as of `lastHeartbeatAt`.
  /// See `HealthCounters` in src/lib/bot-health.ts for what each means
  /// and which alert rule reads it.
  seen               Int @default(0)
  buffered           Int @default(0)
  synthetic          Int @default(0)
  reconstructed      Int @default(0)
  notGroup           Int @default(0)
  degradedEnrichment Int @default(0)
  nameless           Int @default(0)
  reactFailures      Int @default(0)
  flushFailures      Int @default(0)
  droppedMessages    Int @default(0)

  /// Capabilities the Pi itself declared degraded, verbatim from
  /// `whatsapp-bot/src/degraded.ts` (e.g. "participant-sync"). Forwarded
  /// rather than re-derived so a capability added there surfaces without
  /// the server needing to know about it.
  degradedCapabilities String[]

  /// UNUSED SINCE 2026-09-28, kept (not dropped) so nothing destructive
  /// runs against prod. Health alerts are no longer sent, so there is no
  /// dedupe to keep; the record lives in `OpsAlert`. The three columns
  /// below (`lastAlertAt`, `lastAlertCodes`, `codeFirstSeenAt`) hold their
  /// last values from before that date and are written by nothing.
  ///
  /// Alert dedupe, kept HERE rather than in SentNotification because it
  /// is a property of this org's health, not of a match. `alertedCodes`
  /// is what makes "a NEW condition appeared" distinguishable from "the
  /// same thing is still broken" — the difference between speaking up
  /// immediately and waiting for tomorrow morning's digest.
  lastAlertAt    DateTime?
  lastAlertCodes String[]

  /// Per-code first-seen ledger: `{"sweep-stale":"2026-07-07T15:08:13Z"}`.
  /// `lastAlertCodes` answers "was this in the last alert"; this answers
  /// "since when", which is what lets the alert collapse anything that
  /// has been true for more than `COLLAPSE_AFTER_MS` into one dated line
  /// instead of repeating its paragraph every day, and what lets it say
  /// how long something lasted when it finally clears.
  ///
  /// A column and not a table: at most eleven entries, read and written
  /// only as a whole, alongside `lastAlertCodes` which is already a bare
  /// array on this row, and nothing will ever query inside it.
  /// `trackFirstSeen` parses it totally, so any shape is survivable.
  codeFirstSeenAt Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastHeartbeatAt])
}

/// Routine ops alerts, for the platform owner's /admin/health page.
///
/// Until 2026-09-28 every one of these was sent to the owner as a
/// WhatsApp DM and an email (bot-health) or a DM to every club admin
/// (operator notes). He never read them, they buried the messages he
/// does need, and some were false alarms. They are now RECORDED here
/// and nowhere else; see `src/lib/ops-alerts.ts`.
///
/// Two shapes share the table:
///   - a CONDITION (`kind` starts with "health:"): one row per stretch
///     of time a health rule held for a club. `lastSeenAt` moves on
///     every hourly check, `resolvedAt` is set when it stops holding.
///   - an EVENT (`kind` = "operator-note"): one row per occurrence,
///     created with `resolvedAt` already set, so it is never "active".
///
/// `orgId` is a plain column, not a relation, on purpose: this table is
/// written by monitoring code and must never block deleting a club.
model OpsAlert {
  id          String    @id @default(cuid())
  orgId       String?
  kind        String
  /// "critical" | "warning" | "info"
  severity    String
  title       String    @db.Text
  detail      String    @db.Text
  /// Events only: stops the same note being recorded twice.
  dedupeKey   String?
  firstSeenAt DateTime
  lastSeenAt  DateTime
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, kind, resolvedAt])
  @@index([createdAt])
}

model BotJob {
  id           String    @id @default(cuid())
  orgId        String
  kind         String // "dm" | "group" | "group-poll"
  phone        String? // for DM jobs, E.164 without the + prefix
  text         String    @db.Text
  /// Poll fields — set when kind = "group-poll". `text` should mirror
  /// the question for admin-dashboard previews. If pollQuestion is
  /// non-null, pollOptions must contain at least 2 entries.
  pollQuestion String?   @db.Text
  pollOptions  String[]
  pollMulti    Boolean   @default(false)
  /// When set, this job must NOT be dispatched until the clock passes
  /// this instant. Used for player-requested personal reminders
  /// ("@MatchTime remind me on Monday") — the analyzer resolves the
  /// natural-language time to an absolute UTC timestamp and queues a
  /// kind="dm" job with sendAfter in the future. The scheduler's
  /// BotJob block filters `sendAfter == null OR sendAfter <= now()`, so
  /// existing immediate jobs (sendAfter null) are unaffected. Nullable
  /// = additive, zero impact on historical/immediate jobs.
  sendAfter    DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([orgId, sentAt])
  @@index([orgId, sendAfter])
}

/**
 * A player who signalled UNCERTAIN availability ("maybe", "in if my back
 * holds up", "I'll check closer to the match") for a specific match.
 * The analyzer classifies these as intent="conditional_in" with no
 * attendance write (registerAttendance:null) — flavour (b),
 * personal-uncertainty. We record the player as a MAYBE for the match
 * here, then the scheduler proactively DMs them at `dueAt` (kickoff minus
 * TENTATIVE_FOLLOWUP_LEAD_MS, clamped to soon if kickoff is imminent) to
 * get a firm IN/OUT. `dueAt` is computed ONCE at declaration so the
 * lead-time constant is applied deterministically.
 * Lifecycle:
 * - created when conditional_in (flavour b) is detected; idempotent —
 * at most one UNRESOLVED row per (matchId, userId).
 * - `notifiedAt` stamped when the follow-up DM has been dispatched
 * (set on ACK) so it never re-fires.
 * - `resolvedAt` stamped when the player gives a firm IN/OUT (group or
 * DM) OR a send-time guard finds them already CONFIRMED/DROPPED/the
 * match full/completed/cancelled — at which point no follow-up is
 * needed.
 * Strictly additive: a brand-new table, nullable timestamps, no change to
 * Attendance / Match / User columns. Safe `prisma db push` on live prod.
 */
model TentativeAvailability {
  id         String    @id @default(cuid())
  matchId    String
  match      Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  /// When the follow-up DM should fire (kickoff − lead, clamped to soon).
  dueAt      DateTime
  /// Stamped when the follow-up DM has been dispatched (set on ACK).
  notifiedAt DateTime?
  /// Stamped when the player gave a firm IN/OUT or the guard short-circuits.
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([matchId, userId])
  @@index([matchId, resolvedAt])
  @@index([dueAt, resolvedAt])
}

/**
 * Queued retroactive react updates.
 * When a player's slot changes after their original IN message has
 * already been reacted to (drop-and-shift, slot-emoji rule changes,
 * historical fixes), the server queues a row here. The bot's next
 * /due-posts tick picks up unsent rows, calls `msg.react(emoji)` on the
 * existing WhatsApp message, and ACKs back to mark `sentAt`.
 * Reaction replacement is in-place — whatsapp-web.js's react() swaps
 * any existing reaction the bot account placed on that message, so we
 * don't need a separate "clear" step.
 */
model RetroReaction {
  id          String    @id @default(cuid())
  orgId       String
  waMessageId String
  emoji       String
  reason      String? // optional debug note: "slot 5 → 4 after drop"
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, sentAt])
  @@index([waMessageId])
}

/**
 * When someone drops from a confirmed slot, the bot DMs the first bench
 * player and asks them to 👍 (confirm) or 👎 (pass) within 2h. One row
 * per (match, user) attempt. Resolved when a reaction arrives OR when
 * `expiresAt` passes — at which point the server flags this user as
 * dropped and the scheduler posts a new prompt for the next bencher.
 */
model PendingBenchConfirmation {
  id              String    @id @default(cuid())
  matchId         String
  match           Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId          String
  waMessageId     String? // the bot's prompt message id; filled in by /ack
  expiresAt       DateTime
  resolvedAt      DateTime?
  outcome         String? // "confirmed" | "declined" | "expired"
  /// The CONFIRMED player whose drop opened this slot. When this bench
  /// user 👍s, their TeamAssignment takes the dropped player's slot
  /// (the dropped TA row is deleted). On 👎/timeout, the chain to the
  /// next bench player preserves this reference so they're offered
  /// the same slot. Nullable: legacy rows + edge cases (drop happened
  /// before teams were generated) fall back to the old behaviour
  /// (attendance-only confirmation, no team swap, no announcement).
  replacingUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([resolvedAt])
}

/**
 * Bench redesign 2026-05-19 (Kemal). Replaces the sequential
 * elimination chain (PendingBenchConfirmation, now legacy/unused —
 * kept for history, not written anymore).
 * ONE row per OPEN SLOT. A confirmed player dropping opens an offer
 * that is broadcast to EVERY current bench player at once. The FIRST
 * bencher to confirm (👍 / IN / yes — in the group OR by DM) claims
 * it: they're promoted to CONFIRMED, the dropped player's
 * TeamAssignment transfers to them, the group is told, and the offer
 * is resolved. Everyone else stays on the bench — nobody is ever
 * removed for being slow or silent. No per-person timers. Offers
 * auto-close at kickoff.
 * `replacingUserId` = the dropped CONFIRMED player (for the TA swap +
 * "X takes Y's place" wording). `waMessageId` = the group offer post
 * (set on /ack) so a 👍 reaction maps back to the offer.
 * `claimedByUserId` = who won it (audit). `resolvedAt` set when
 * claimed or auto-closed at kickoff.
 */
/// One ask to the admin channel to fill open places from the waiting list
/// (slice 2b, 2026-10-01). Plan: MDs/friday-group-features-plan-2026-09-30.md,
/// sections 2.7 to 2.11. At most one open round (resolvedAt NULL) per match,
/// guarded by a SentNotification claim when it opens. Only organiser-pick
/// clubs ever have rows.
model OrganiserPickRound {
  id                          String    @id @default(cuid())
  matchId                     String
  match                       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  orgId                       String
  /// "dm" | "admin-group", fixed when the round opens.
  channel                     String
  /// Whose DM replies are read. For "dm", the recipients; for
  /// "admin-group", the one person a notice falls back to by DM when the
  /// Pi cannot post in the group (the owner).
  recipientUserIds            String[]  @default([])
  /// The numbered waiting list exactly as sent. Reply numbers resolve here.
  listUserIds                 String[]
  /// The drops this round is about (wording only).
  vacatedByUserIds            String[]  @default([])
  /// Of those, which were after the drop-out deadline (wording only).
  lateDropUserIds             String[]  @default([])
  openPlaces                  Int
  /// "drop" | "open-place" | "deadline-summary"
  reason                      String
  fallbackAt                  DateTime
  /// E1: a "not on the waiting list, YES?" question waiting for an answer.
  pendingConfirmUserId        String?
  pendingConfirmAskedByUserId String?
  pendingConfirmAskedAt       DateTime?
  resolvedAt                  DateTime?
  /// "filled" | "none-by-admin" | "fallback-bench-offer" |
  /// "fallback-left-open" | "superseded" | "closed-at-kickoff"
  outcome                     String?
  pickedUserIds               String[]  @default([])
  lastPickedByUserId          String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([matchId, resolvedAt])
  @@index([orgId, resolvedAt])
}

model BenchSlotOffer {
  id              String    @id @default(cuid())
  matchId         String
  match           Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  replacingUserId String?
  waMessageId     String?
  claimedByUserId String?
  resolvedAt      DateTime?
  outcome         String? // "claimed" | "closed-at-kickoff"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([matchId, resolvedAt])
}

model Attendance {
  id            String           @id @default(cuid())
  matchId       String
  match         Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  status        AttendanceStatus @default(CONFIRMED)
  position      Int              @default(0)
  respondedAt   DateTime         @default(now())
  /// Non-null when the player has marked themselves as paid for this
  /// match. Populated by the bot when the voter ticks their team's
  /// option in the WhatsApp payment poll; can also be toggled from
  /// the admin match page. Scheduler uses this to chase unpaid players
  /// on the daily 17:00 squad nudge. Nullable = additive, zero impact
  /// on historical attendance rows.
  paidAt        DateTime?
  /// When this attendance was paid for via someone else (bulk
  /// payment by the same WhatsApp member who collected several
  /// players' fees). Populated when an admin says e.g. "Amir paid
  /// for Faris and Adam" — the bot resolves Amir → User and stores
  /// his id here against Faris's and Adam's Attendance rows. Useful
  /// for audit / undo. Nullable = additive.
  paidViaUserId String?

  /// ─── Stripe per-player payment (2026-06-03) ─────────────────────
  /// How this player chose to pay: "pay_by_bank" | "card" | "direct".
  /// Null until they pick / are sent a link.
  paymentMethod           String?
  /// Total charged for this row incl. the per-method processing uplift
  /// (and quantity if they paid for others). £.
  paymentAmount           Float?
  /// How many people this payment covered (self + guests). Default 1.
  paymentQuantity         Int       @default(1)
  /// Stripe Checkout Session id (card / pay-by-bank). Null for direct.
  stripeSessionId         String?
  /// Set when the player chose "pay the collector directly" and we're
  /// awaiting the collector's confirmation. Cleared (→ paidAt) on confirm.
  directPendingAt         DateTime?
  /// Who confirmed the direct payment (the money collector).
  directConfirmedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([matchId, status])
}

/**
 * APPEND-ONLY attendance audit log (2026-09-01).
 * WHY IT EXISTS
 * -------------
 * `Attendance` records what a squad IS. Nothing recorded what it WAS.
 * That is not a cosmetic gap: `e2e/replay/` can only replay 447 of
 * 1,723 real production messages (25.9%) because 1,149 of them landed
 * in a world that cannot be reconstructed — a row that existed before a
 * batch and was touched after it has an unknowable status AT that
 * instant, and Sutton's per-player payment metadata bumps `updatedAt`
 * on settled rows for days after the whistle, which widens it further.
 * §10 step 6 of MDs/analyzer-redesign-2026-08-31.md — swapping the
 * attendance WRITE path, the only change in the redesign that can put a
 * player at a pitch with no slot — is meant to turn on that evidence.
 * WHAT IT GUARANTEES
 * ------------------
 * 1. APPEND-ONLY. A database trigger (`attendance_event_no_mutate`)
 * rejects every UPDATE and DELETE on this table. Its whole value is
 * that it is the one thing here that cannot be rewritten, so that is
 * enforced in the database and not by convention. TRUNCATE is
 * deliberately still allowed — the e2e fixture world resets that way
 * and a test database is not an audit trail.
 * 2. WRITTEN IN THE SAME TRANSACTION as the attendance change it
 * records, so the log can never disagree with the state.
 * 3. It records the CAUSE, not just the effect. A replay has to be able
 * to tell a drop that came from a bench claim from a self-OUT.
 * NO FOREIGN KEYS — DELIBERATE
 * ----------------------------
 * `matchId` / `userId` / `orgId` / `actorUserId` are plain strings, not
 * relations. An FK would carry a referential action, and every honest
 * choice is wrong for a log: CASCADE deletes history when a match or a
 * merged-away user is removed (`Attendance` is `onDelete: Cascade` from
 * `Match`), and RESTRICT would make the log block ordinary deletes.
 * `UserMerge.oldUserId` sets the same precedent for the same reason: a
 * record of what happened has to outlive the row it describes.
 * GROWTH
 * ------
 * One row per attendance TRANSITION, not per message. Sutton FC's real
 * rate is roughly 25-40 transitions a week (a 14-player squad, one
 * match a week, plus drops, bench moves and the odd format switch), so
 * ~2k rows a year per active club at ~250 bytes: well under 1 MB/year.
 * There is deliberately NO retention policy — see the PR. Adding one
 * silently would defeat the point of the table.
 */
model AttendanceEvent {
  id String @id @default(cuid())

  /// Which squad place this is about. Plain strings — see NO FOREIGN
  /// KEYS above.
  matchId String
  userId  String
  /// Denormalised so the log can be read (and retained) per club
  /// without joining through Match → Activity.
  orgId   String

  /// The status the row held IMMEDIATELY BEFORE this event.
  /// NULL = no Attendance row existed (a first registration).
  fromStatus   AttendanceStatus?
  /// The status the row holds IMMEDIATELY AFTER.
  /// NULL = the row was DELETED (admin "remove from match", or a merge
  /// dropping a duplicate). A deletion is a transition like any other
  /// and is the one the old model lost completely.
  toStatus     AttendanceStatus?
  fromPosition Int?
  toPosition   Int?

  /// WHY this happened — one of ATTENDANCE_EVENT_CAUSES in
  /// `src/lib/attendance-events.ts`. A String rather than an enum
  /// deliberately: adding a cause must never need a migration on a live
  /// database, and this column is read by humans and by the replay
  /// harness, never branched on by the write path. Same precedent as
  /// `AnalyzedMessage.handledBy` and `BenchSlotOffer.outcome`.
  cause       String
  /// WHO caused it: "player" | "member" | "admin" | "scheduler" |
  /// "system" | "script". The player themselves and a third party are
  /// different facts even when the effect is identical.
  actorKind   String
  /// The user who caused it — the sender, the admin, the bench claimant.
  /// NULL for scheduler/system/script.
  actorUserId String?
  /// Provenance: a WhatsApp message id, an analyze batch id, a
  /// BenchSlotOffer id, a script name. Free-form, never parsed.
  sourceRef   String?
  /// Human detail for triage. Never parsed, never branched on.
  note        String? @db.Text

  /// The Postgres transaction that wrote this event, so a reader can
  /// group the events of one atomic change (a format switch recuts a
  /// whole squad at once) and so the e2e coverage trigger can prove an
  /// attendance write and its event shared a transaction. Filled by the
  /// DATABASE, never by the application.
  txId String? @default(dbgenerated("txid_current()::text"))

  at DateTime @default(now())

  @@index([matchId, at])
  @@index([matchId, userId, at])
  @@index([orgId, at])
  @@index([userId, at])
  @@index([txId])
}

/**
 * Bulk-payment credit recorded by an admin via natural-language WA
 * message (e.g. "Amir paid for 4 players"). Used when individual
 * names aren't given and we just have a count to credit against the
 * match. Each row offsets the unpaid count for that match by `count`.
 * If the admin DOES name specific players, the bot updates each
 * Attendance.paidAt + paidViaUserId directly and does NOT create a
 * PaymentCredit row — avoids double-counting.
 * Authorisation: only OWNER/ADMIN of the org can create these.
 */
model PaymentCredit {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  payerUserId  String // who collected/paid the venue
  count        Int // how many players' fees this covers
  note         String? // optional context
  recordedById String // sender of the credit instruction (for audit)
  recordedAt   DateTime @default(now())

  @@index([matchId])
}

model TeamAssignment {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  team    Team

  @@unique([matchId, userId])
}

model Rating {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId  String
  rater    User   @relation("RatingsGiven", fields: [raterId], references: [id])
  playerId String
  player   User   @relation("RatingsReceived", fields: [playerId], references: [id])
  score    Int // 1-10

  createdAt DateTime @default(now())

  @@unique([matchId, raterId, playerId])
  /// The club rating reads "this player's ratings, newest first, capped
  /// at 60", then filters by org through match to activity. The unique
  /// above is left-prefixed on matchId and cannot serve that. 2026-09-18.
  @@index([playerId, createdAt])
}

model MoMVote {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voterId  String
  voter    User   @relation("MoMVotesGiven", fields: [voterId], references: [id])
  playerId String
  player   User   @relation("MoMVotesReceived", fields: [playerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([matchId, voterId])
}

/**
 * Smart-analysis dedupe key: every WhatsApp group message the bot
 * processes gets recorded here by its `waMessageId`. The inline path
 * (fast-path + LLM), periodic catch-up scan, and startup backfill all
 * check this table first so no message is processed twice. The
 * `intent` / `action` columns record what the bot decided, useful for
 * auditing and prompt-tuning.
 * handledBy:
 * - "fast-path": regex matched (IN/OUT/score); acted inline
 * - "llm":       sent to Claude for classification; action executed
 * - "ignored":   skipped on purpose (bot's own msg, non-c.us author, empty body)
 * - "error":     analyzer call failed; don't re-try this exact message
 */
/// ─── What each club spent on AI, per London calendar day (2026-09-29) ──
/// One row per (orgId, day), written only by `src/lib/ai-budget.ts`.
/// `costUsd` is REAL spend, priced from the model's own usage report by
/// `costOf()` in `src/lib/pipeline/llm.ts`. `reservedUsd` is money held
/// for calls still in flight (see `ai-budget.ts` for why a reservation
/// makes the cap safe under concurrency); it drains to 0 as each call
/// settles, so a non-zero value at the end of a day means a process died
/// mid-call and only ever made that day's cap stricter.
///
/// `orgId` is NOT a foreign key. It is an `Organisation.id` for every
/// club, and a prefixed key for the two kinds of AI spend that happen
/// before a club exists: `onboarding-group:<groupId>` (the in-group
/// setup conversation) and `onboarding-user:<userId>` (the web wizard's
/// chat analysis). The prefixes cannot collide with a cuid.
///
/// Read by the owner dashboard. Nobody is ever DMed or emailed about a
/// cap hit: `cappedAt` is the record.
model OrgAiUsage {
  orgId           String
  /// The London calendar day, midnight to midnight Europe/London.
  day             DateTime  @db.Date
  costUsd         Float     @default(0)
  reservedUsd     Float     @default(0)
  /// Model calls that completed and were billed.
  calls           Int       @default(0)
  /// Model calls refused because the cap was reached.
  refusedCalls    Int       @default(0)
  /// Group messages that got no AI handling today because of the cap
  /// (the ones the deterministic floor could not handle).
  skippedMessages Int       @default(0)
  /// The cap in force the last time it was evaluated, for the dashboard.
  capUsd          Float?
  /// The first moment today that a call was refused. NULL = never capped.
  cappedAt        DateTime?
  /// When the one polite "ask me tomorrow" line went to the group today.
  capReplySentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@id([orgId, day])
  @@index([day])
}

model AnalyzedMessage {
  id           String  @id @default(cuid())
  waMessageId  String  @unique
  orgId        String
  groupId      String
  authorPhone  String?
  authorUserId String?
  /// WhatsApp pushname at analysis time. Persisted so the admin
  /// "unresolved messages" queue can show WHO ("ba") to link to a
  /// player when authorUserId is null. Nullable + additive.
  authorName   String?
  body         String? @db.Text
  handledBy    String
  intent       String?
  action       String?
  confidence   Float?
  reasoning    String? @db.Text

  /// The analyze REQUEST this message was reasoned about in (2026-09-01).
  /// The Pi buffers inbound messages and flushes a WINDOW to
  /// `/api/whatsapp/analyze`; the route reasons over the whole window at
  /// once, so the batch — not the message — is the unit anything
  /// replaying this history has to reconstruct. Until now no batch id was
  /// stored, so `e2e/replay/reconstruct.ts` recovered batches from WRITE
  /// TIMING: gaps under 2s are one flush, over 10s are certainly two, and
  /// the 62 batches whose gaps landed in between were thrown away because
  /// "one slow flush" and "two quick ones" are indistinguishable.
  /// One nullable column removes that class of guess. Stamped by the
  /// analyze route for every message in a request (see
  /// `src/lib/analyze-batch-context.ts`); NULL on every row written
  /// before this shipped, and null-safe everywhere it is read.
  batchId String?

  /// WHAT THE MODEL SAID about this message (2026-09-24): the router's
  /// route and each extractor's FACTS, with the model that produced them
  /// and the stage's degradations. The columns above record what the
  /// ENGINE decided; this records what it was told, so "was it the
  /// extractor or the engine?" is answerable from the row. Written once
  /// at the end of the analyze request by `pipeline/trace.ts`, which
  /// also defines the shape (`PipelineTrace`, versioned by `v`) and the
  /// bounds: clipped strings, capped arrays, at most 16k characters, no
  /// phone numbers. NULL for rows written before it shipped and for
  /// messages that never reached the router. Read with
  /// `scripts/trace-message.ts`.
  pipelineTrace Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([groupId, createdAt])
  @@index([orgId, authorUserId, createdAt])
  @@index([batchId])
}

/**
 * Per-org alias for a user — the WhatsApp pushname (or nickname /
 * variant spelling) that doesn't fuzzy-match the canonical DB name.
 * Populated automatically when an admin merges a provisional ghost
 * into a real user: the ghost's display name becomes an alias for
 * the real user, scoped to the org. Next time a message arrives with
 * that pushname (and no phone — typical @lid privacy mode case), the
 * resolver finds the real user via alias instead of creating another
 * ghost.
 * Stored lower-cased + diacritics-stripped to match the resolver's
 * comparison key.
 */
model UserAlias {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  alias     String // already-normalised key
  source    String       @default("merge") // "merge" | "manual" | "auto-detect"
  createdAt DateTime     @default(now())

  @@unique([orgId, alias])
  @@index([userId])
  @@index([orgId])
}

/**
 * Merge tombstone (2026-06-12). When two duplicate User rows are merged,
 * the dropped row is DELETED — so any id captured before the merge (e.g.
 * a rated playerId baked into a rating submission, a cached squad list)
 * becomes a dangling reference. This row records old→new so those stale
 * ids can be REMAPPED to the survivor instead of silently dropped.
 * `oldUserId` is a PLAIN STRING, not an FK — the row it points at is
 * gone by the time this is queried. Chains are possible (a survivor may
 * itself later be merged away), so readers follow `oldUserId →
 * survivorUserId` transitively with a small hop cap to break cycles.
 * Written inside the same transaction as the user delete in
 * `mergePlayersCore`. Read by `submitRatings` / `submitMoMVote` to
 * remap a merged-away player to the survivor (respecting their unique
 * keys) rather than skipping the score.
 */
model UserMerge {
  id             String   @id @default(cuid())
  oldUserId      String // dropped (deleted) user id — NOT an FK
  survivorUserId String // surviving keeper user id
  orgId          String
  createdAt      DateTime @default(now())

  @@index([oldUserId])
}

/**
 * Phase 4 hybrid LLM team-balancer audit trail.
 * Before the deterministic balancer runs, an LLM reads the last ~7 days
 * of group chat and proposes per-player rating deltas based on
 * conditions for tonight (sick, tentative, hot streak, rusty). The
 * balancer then runs with the adjusted ratings.
 * One row per (match, user) — captures what the LLM said and why so an
 * admin can audit balance decisions ("why was Wasim on Yellow?").
 * Delta is clamped to [-2, +2] in the analyser so a single hallucination
 * can't dominate the balance. Confidence < 0.3 is treated as no signal.
 */
model RatingAdjustment {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  delta      Float
  reason     String   @db.Text
  confidence Float
  createdAt  DateTime @default(now())

  @@unique([matchId, userId])
  @@index([matchId])
}

/**
 * Raw archive of group messages for orgs running `featureSquadFromList`.
 * For those orgs (Amir's Thursday group, 2026-05-20) the per-batch
 * analyzer is OFF (cost) but we still need to read the latest pasted
 * squad list to know who played, so the bot DMs the right people for
 * MoM voting + ratings. The analyze route stores every inbound message
 * here without calling the LLM. A single squad-extraction LLM call
 * (Sonnet, folded into /api/cron/generate-teams — Vercel project cron
 * cap = 3) runs over messages SINCE THE PREVIOUS MATCH ENDED to find
 * squad lists, attribute additions to senders (ground-truth UserAlias
 * learning), and resolve the final squad at kickoff. Starting at the
 * previous match's end (not a fixed rolling window) matters because
 * some groups paste the next week's list within minutes of the final
 * whistle — a rolling window would either chop those off or drag in
 * stale lists from before the previous match.
 * Only written when the org has `featureSquadFromList=true` — Sutton
 * and other live orgs are unaffected.
 * Idempotent on `waMessageId` (unique). Sender resolution happens at
 * extraction time, not write time, so a phone + pushname pair becomes
 * useful even before the User exists in our DB.
 */
model GroupMessage {
  id             String       @id @default(cuid())
  orgId          String
  org            Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  waMessageId    String       @unique
  waChatId       String?
  /// E.164 phone of the sender, if WhatsApp delivered one. Empty/null
  /// when the sender is @lid (privacy mode) — pushname is then the
  /// only handle we have.
  senderPhone    String?
  /// WhatsApp pushname (display name) at message time. Persisted so the
  /// diff-attribution pass can compare "what name did this sender add"
  /// against "what name does this sender go by", to learn aliases.
  senderPushname String?
  body           String       @db.Text
  /// WhatsApp's own message timestamp (UTC). The diff pass orders by
  /// this — NOT createdAt — so out-of-order ingestion (Pi catch-up
  /// after a restart) still produces the correct list sequence.
  timestamp      DateTime
  createdAt      DateTime     @default(now())

  @@index([orgId, timestamp])
}

/**
 * Shadow analyzer output (2026-05-29). The current `/api/whatsapp/analyze`
 * route forces Claude to emit a structured verdict per message, then
 * runs server-side regex safety-nets to "fix" wrong verdicts. That
 * bandaid layer is itself the source of recurring bugs (Kemal dropped
 * from his own squad 2026-05-28; Mojib not dropped 2026-05-26; etc.).
 * The shadow path runs alongside the live analyzer on every Pi flush.
 * It sends the SAME window (fresh batch + history) to a fresh, concise
 * prompt that returns ONE coherent state diff for the window — no
 * per-message verdicts to conflict with each other, no safety nets to
 * override. Output is persisted here for offline comparison; no
 * attendance is written by this path until we cut over.
 * `currentVerdictRefs` is the array of AnalyzedMessage IDs that the
 * LIVE analyzer wrote for the same batch, so the /admin/shadow dash
 * can render side-by-side: shadow's single diff vs live's per-message
 * verdicts, with a cheap "agree?" badge.
 */
model WindowVerdict {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// First message timestamp in the batch (or now() if the batch was empty).
  windowStart        DateTime
  /// Last message timestamp in the batch.
  windowEnd          DateTime
  /// SHA-256 of the sorted waMessageIds in the batch — lets us dedupe
  /// re-runs on the same window (Pi catch-up resending) without a
  /// second Claude call.
  batchHash          String
  /// Wall-clock ms the shadow Claude call took. Cheap proxy for window
  /// complexity + lets us spot regressions.
  modelMs            Int
  /// Best-effort USD cost of this shadow call (input+output tokens).
  /// Null if pricing lookup failed.
  costUsd            Float?
  /// Full Claude response parsed into our shadow schema. See
  /// `src/lib/window-analyzer.ts` for the type. Includes
  /// stateChanges, reactions, optional groupReply, windowSummary.
  verdictJson        Json
  /// The AnalyzedMessage IDs that the live per-message analyzer wrote
  /// for this same batch. Used by the dashboard for side-by-side.
  currentVerdictRefs String[]
  createdAt          DateTime     @default(now())

  @@unique([orgId, batchHash])
  @@index([orgId, windowEnd])
}

/// Short-code wrapper for magic links (2026-06-05). The DM contains
/// `/r/<code>` (~30 chars) instead of the full ~250-char signed token;
/// the code resolves back to the token server-side via /api/r/[code].
/// Purely additive — legacy long-token links (which contain a ".") bypass
/// this entirely and keep working. Generation falls back to the long URL
/// if a row can't be written, so a DB hiccup never breaks sign-in links.
model ShortLink {
  /// Random URL-safe code, e.g. "k7Qp2m9".
  code      String   @id
  /// The full signed magic-link token this code stands in for.
  token     String   @db.Text
  /// Mirrors the token's own exp — the resolver rejects expired codes.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// One "Add MatchTime to WhatsApp" attempt by a self-join organiser
/// (2026-09-29, slice 1 of MDs/self-join-and-approval-plan-2026-09-28.md,
/// section 3.2). Created and advanced by later slices; slice 1 only
/// READS it, to keep the group it names silent until the club is
/// approved (`loadSilentGroupIds` in src/lib/club-approval.ts).
///
/// The 4-character code is a pointer, not the security: the proof is
/// the organiser's phone (or LID) matching the person who added
/// MatchTime to the group.
model ClubConnect {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The organiser: OWNER of the draft club.
  userId    String
  /// Their verified signup phone, digits only.
  phone     String
  /// 4 chars, alphabet without 0 O 1 I L.
  code      String
  /// "issued" | "dm_verified" | "group_linked" | "expired" | "superseded" | "closed"
  status    String       @default("issued")
  issuedAt  DateTime     @default(now())
  /// issuedAt + 60 minutes.
  expiresAt DateTime

  // The connect DM
  dmAt                    DateTime?
  dmPhone                 String?
  dmLid                   String?
  dmPhoneMatched          Boolean?
  /// Idempotency for a re-forwarded DM.
  dmWaMessageId           String?   @unique
  lastMismatchAt          DateTime?
  lastMismatchPhoneMasked String?
  /// dmAt + 24 hours.
  addWindowEndsAt         DateTime?
  /// The organiser's connect DM arrived while cap 6 (new groups linked
  /// across the site per day) was full. The card shows the cap line that
  /// day; the code stays issued. Self-join slice 5.
  siteCapAt               DateTime?

  // The group add
  groupId         String?
  groupSubject    String?
  memberCount     Int?
  addedByPhone    String?
  addedByLid      String?
  /// "phone" | "lid" | "other-organiser-present" | "unknown" | "mismatch"
  adderMatch      String?
  /// Participant snapshot at add time, imported at approval.
  participants    Json?
  detectedLang    String?
  linkedAt        DateTime?
  /// The one DM to the platform owner, once.
  ownerDmQueuedAt DateTime?
  /// MatchTime was removed from the group while pending.
  botRemovedAt    DateTime?
  /// F3 (2026-10-05): the chat history WhatsApp shared when MatchTime was
  /// added (HistoryMessage[], oldest first), kept ONLY until the learned
  /// setup has read it once after approval, then set back to NULL. Also
  /// cleared when the club is rejected. NULL = none captured.
  capturedHistory Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code, status])
  @@index([orgId, status])
  @@index([groupId])
  /// Slice 6 resolves a LID-only group adder through the connect DM's LID.
  @@index([dmLid])
  /// Cap 6 counts today's connect DMs.
  @@index([dmAt])
}

/// A group MatchTime was added to with no connect code behind it
/// (2026-09-29, plan section 5.6). MatchTime never speaks in it and never
/// forwards its messages: it is in `silentGroups` from the moment the
/// row exists until `leftAt`. Recorded by a later slice; slice 1 only
/// reads it.
model UnsolicitedGroup {
  id                String    @id @default(cuid())
  groupId           String
  subject           String?
  memberCount       Int?
  addedByPhone      String?
  addedByLid        String?
  addedAt           DateTime  @default(now())
  /// Set when MatchTime has left the group.
  leftAt            DateTime?
  /// Slice 2a (2026-09-30): added by an owner or admin of an approved
  /// club. Silent, no setup, waiting for "@Match Time admin group CODE".
  /// Linking marks the row left.
  awaitingAdminLink Boolean   @default(false)

  @@index([groupId, leftAt])
}

/// A DM or an action that belongs to NO live club (self-join slice 3,
/// plan section 3.3): sign-up codes, the connect reply, the one approval
/// DM to the owner, the organiser's decision DM, leaving a group.
///
/// Why not `BotJob`: `BotJob.orgId` is required and BotJobs only go out
/// through `due-posts`, which 404s for any club whose bot is off. Sign-up
/// codes used to borrow "the first bot-enabled org" as a sender, so muting
/// Sutton FC silently stopped every sign-up.
///
/// Dispatched by `GET /api/whatsapp/platform-jobs`, which CLAIMS each job
/// as it hands it out (status queued -> claimed, compare-and-set), the
/// same at-most-once rule as `due-posts`. The Pi reports the outcome to
/// `POST /api/whatsapp/platform-jobs`:
///   sent     the send resolved (waMessageId when the library gave one)
///   failed   the send threw; `failReason` says why. NOT retried, and
///            never recorded as sent.
///   release  the Pi's DM pacing held it back; it goes back to queued.
/// "unconfirmed" is only written for a job an OLDER Pi took through the
/// due-posts bridge and acked without a message id, which that build
/// also does when the send failed.
///
/// Writers: `src/lib/platform-jobs.ts` and `src/lib/owner-dm.ts` only
/// (`__tests__/platform-jobs-source-guard.test.ts`).
model PlatformJob {
  id          String    @id @default(cuid())
  /// "dm" | "leave-group"
  kind        String
  /// For "dm": digits, no "+".
  phone       String?
  /// For "leave-group".
  groupId     String?
  text        String?   @db.Text
  /// "otp" | "connect-reply" | "organiser-decision" | "owner-approval" | "owner-ack" | "leave-group"
  purpose     String
  /// ClubConnect.id and the like, for dedupe and the owner page.
  refId       String?
  /// "queued" | "claimed" | "sent" | "failed" | "unconfirmed"
  status      String    @default("queued")
  /// Not dispatched before this instant (the owner DM's quiet hours).
  sendAfter   DateTime?
  claimedAt   DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  failReason  String?   @db.Text
  waMessageId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, sendAfter])
  @@index([purpose, refId])
  @@index([kind, groupId])
}

/// F3, LEARNED SETUP (2026-10-05). Once per club, right after a self-join
/// club is approved, MatchTime reads the chat history WhatsApp shared when
/// it joined (ClubConnect.capturedHistory) with ONE cheap model call, works
/// out how the group runs, applies the matching settings and DMs the
/// organiser what it set. This row is the record: what was detected, what
/// was applied (each with its chat evidence and an undo), what was only
/// suggested, the patterns noted, and what the call cost. orgId is unique,
/// which is what makes it once per club. See src/lib/setup-learning/.
model ClubSetupLearning {
  id           String       @id @default(cuid())
  orgId        String       @unique
  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// "running" | "deferred" | "applied" | "nothing" | "skipped" | "failed"
  status       String       @default("running")
  /// Why it was skipped, deferred or failed: "no-history" | "too-short" |
  /// "not-a-game-group" | "ai-cap" | "model-error" | "no-organiser".
  reason       String?
  attempts     Int          @default(1)
  messageCount Int          @default(0)
  authorCount  Int          @default(0)
  /// The normalised model answer (evidence quotes verified against the chat).
  detected     Json?
  /// [{ key, from, to, evidence[], undoneAt? }]
  applied      Json?
  /// [{ key, current, detected, evidence[] }]: the weekly game and the
  /// language, which the organiser set on the website and are never changed.
  suggestions  Json?
  /// [{ key: "monthlyList", ... }]: patterns MatchTime has no setting for yet.
  noted        Json?
  /// [{ key, reason }]: detected but left alone, and why.
  kept         Json?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  dmQueuedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

/**
 * ─── Monthly squad (2026-10-05, slice 2) ───────────────────────────────
 * Plan: MDs/monthly-squad-plan-2026-10-05.md, sections 3 and 4.5.
 * Three tables, all empty until a club with `squadMode = "monthly"`
 * opens a month. Slice 2 only writes them from /admin/months (an
 * organiser starting the current month); nothing is posted to WhatsApp.
 * Every write goes through src/lib/squad-month.ts.
 * One row per club fixture (the Activity, one weekly game) per calendar
 * month. `monthStart` is the London 1st of the month as a DATE.
 */
model SquadMonth {
  id                     String       @id @default(cuid())
  orgId                  String
  org                    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activityId             String
  activity               Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  monthStart             DateTime     @db.Date
  /// "open" (sign-up) | "priced" (amounts posted) | "running" | "closed".
  /// A month an organiser starts part-way through is "running" at once.
  status                 String       @default("open")
  /// The month's games of this fixture, played ones included.
  gamesScheduled         Int          @default(0)
  /// Set by the organiser (D1). NULL until priced.
  sharePerGamePence      Int?
  concessionPerGamePence Int?
  /// NULL = newcomers pay the standard share.
  newcomerPerGamePence   Int?
  /// Optional bookkeeping, per game.
  venueCostPence         Int?
  payByAt                DateTime?
  /// Idempotency claims, compare-and-set (like `Match.rollingSeededAt`).
  listOpenedAt           DateTime?
  pricedAt               DateTime?
  closedAt               DateTime?
  summarySentAt          DateTime?

  /// ─── Starting part-way through a month (plan 4.5) ───────────────
  /// When an organiser opened this month after it had begun, seeding it
  /// from their own list. NULL for a month MatchTime opened itself.
  startedMidMonthAt      DateTime?
  startedByUserId        String?
  /// Games of this month already played when it was started here. They
  /// count as played for every regular seeded then: no credit, no
  /// absence, and MatchTime may hold no Match row for them at all.
  gamesPlayedBeforeStart Int       @default(0)

  members        SquadMonthMember[]
  creditsEarned  SquadCredit[]      @relation("SquadCreditEarnedMonth")
  creditsApplied SquadCredit[]      @relation("SquadCreditAppliedMonth")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, activityId, monthStart])
  @@index([status])
}

/// One row per person per month.
model SquadMonthMember {
  id             String     @id @default(cuid())
  monthId        String
  month          SquadMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "regular" | "payg".
  kind           String     @default("regular")
  /// "standard" | "concession" (regulars only).
  tier           String     @default("standard")
  /// The list number, stable for the month. NULL for a PAYG player with
  /// no slot of their own.
  slot           Int?
  /// "PAYG 5th only": the dated matches this PAYG player is in for.
  paygMatchIds   String[]   @default([])
  /// Weeks a regular has said ahead of time they will miss.
  absentMatchIds String[]   @default([])
  /// Games this person pays for: the whole month, or what was left of it
  /// when they joined. A regular seeded at a mid-month start covers the
  /// whole month (the games already played count as played).
  gamesCovered   Int        @default(0)
  /// Credits used against this month, in games.
  creditsApplied Int        @default(0)
  /// share x (gamesCovered - creditsApplied). NULL while no share is set.
  amountDuePence Int?

  /// "Says paid" (D3): a claim, never a confirmation.
  paidClaimedAt          DateTime?
  /// "list" | "dm" | "page" | "other-player" | "organiser".
  paidClaimSource        String?
  paidClaimedAmountPence Int?
  /// Confirmed: by the collector or an admin, or by Stripe (slice 7).
  paidAt                 DateTime?
  paidAmountPence        Int?
  paidConfirmedByUserId  String?
  /// "bank" | "card" | "cash". NULL = not recorded.
  paymentMethod          String?
  stripeSessionId        String?

  /// How the row came to be: "seed-list" | "seed-tick" (a mid-month
  /// start), later "paste" | "reply" | "page" | "admin".
  source        String    @default("admin")
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  /// Recorded only: MatchTime moves no money for a bank transfer.
  refundedPence Int       @default(0)
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([monthId, userId])
  @@index([userId])
}

/// The credits ledger: one row per credit, counted in GAMES (a credit is
/// worth the share of the month it is used in). Never deleted: a wrong
/// credit is voided, like `AttendanceEvent` is append-only.
model SquadCredit {
  id     String       @id @default(cuid())
  orgId  String
  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  games  Int          @default(1)
  /// "missed" | "cancelled-week" | "left-mid-month" | "manual" |
  /// "carried-in" (the organiser told us, at a mid-month start, that this
  /// regular came into the month with it).
  reason String

  earnedMonthId  String?
  earnedMonth    SquadMonth? @relation("SquadCreditEarnedMonth", fields: [earnedMonthId], references: [id], onDelete: SetNull)
  /// The match missed or cancelled. No foreign key: the ledger outlives it.
  earnedMatchId  String?
  /// NULL until used.
  appliedMonthId String?
  appliedMonth   SquadMonth? @relation("SquadCreditAppliedMonth", fields: [appliedMonthId], references: [id], onDelete: SetNull)
  appliedAt      DateTime?

  voidedAt    DateTime?
  voidedById  String?
  createdById String?

  createdAt DateTime @default(now())

  @@index([orgId, userId])
  @@index([earnedMonthId])
  @@index([appliedMonthId])
}
