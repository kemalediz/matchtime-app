    "status": 200,
    "writes": [
      {
        "args": {
          "data": {
            "code": "<code>",
            "expiresAt": "2026-11-06T12:00:00.000Z",
            "token": "eyJ1c2VySWQiOiJ1LWZuZi1vcmciLCJwdXJwb3NlIjoic2lnbi1pbiIsIm5leHRQYXRoIjoiL2FkbWluL3NldHRpbmdzIiwib3JnSWQiOiJvcmctZm5mIiwiaWF0IjoxNzkzNzkzNjAwLCJleHAiOjE3OTM5NjY0MDB9.brlJaf9UMAQr1fd9vsYMuk0W8JPxs1kKVhlNr8XcqXU",
