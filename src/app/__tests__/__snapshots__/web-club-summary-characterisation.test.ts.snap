<input type="checkbox" data-testid="season-break-month" data-month="2027-10" class="h-4 w-4 rounded border-slate-300"/>October 2027</label>
</div>
<button type="submit" data-testid="season-break-save" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium disabled:opacity-50">Save</button>
</form>
</div>",
