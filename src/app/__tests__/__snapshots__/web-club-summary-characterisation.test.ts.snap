  "pay first match, paying directly": "<div class="min-h-screen flex items-center justify-center px-5 bg-slate-50">
<div class="w-full max-w-sm bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
<div class="text-center">
<div class="text-5xl mb-3">🤝</div>
<h1 class="text-xl font-bold text-slate-900">Paying Kemal directly</h1>
