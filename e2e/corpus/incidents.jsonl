{"id":"S25-short-confirm-after-pending-list","title":"a one-word 'Confirmed' after MatchTime lists pending names registers those names","sections":["S25","S16"],"category":"B","provenance":{"kind":"commit","ref":"7453daa","date":"2026-04-24","player":"Amir Ahmadi","note":"Third conversational pattern: MatchTime lists N people as pending, and a short ack shortly afterwards is an answer to THAT listing. Closes the Amir → 'two of my guys' → names → 'Confirmed' loop without human intervention."},"world":{"maxPlayers":14,"players":[{"key":"kemal","name":"Kemal Ediz","role":"OWNER"},{"key":"elvin","name":"Elvin Aliyev","role":"ADMIN"},{"key":"sait","name":"Sait Demir"},{"key":"mustafa","name":"Mustafa Kaya"},{"key":"abid","name":"Abid Hussain"},{"key":"idris","name":"Idris Bello"},{"key":"faris","name":"Faris Nasser"},{"key":"shaz","name":"Shaz Iqbal"},{"key":"adam","name":"Adam Osman"},{"key":"efat","name":"Efat Rahman"},{"key":"usama","name":"Usama Tariq"},{"key":"karahan","name":"Karahan Yildiz"},{"key":"zair","name":"Zair Malik"},{"key":"wasim","name":"Wasim Akhtar"},{"key":"habib","name":"Habib Rahimi"},{"key":"najib","name":"Najib Ahmadi"},{"key":"ehtisham","name":"Ehtisham Ul Haq"},{"key":"mojib","name":"Mojib Sadat"},{"key":"erdal","name":"Erdal Ozkan"},{"key":"enayem","name":"Enayem Rashid"},{"key":"amir","name":"Amir Ahmadi"},{"key":"zeeshan","name":"Zeeshan Khan"},{"key":"ayoub","name":"Ayoub Benali"}],"attendance":[{"key":"kemal","status":"CONFIRMED"},{"key":"elvin","status":"CONFIRMED"},{"key":"sait","status":"CONFIRMED"},{"key":"mustafa","status":"CONFIRMED"},{"key":"abid","status":"CONFIRMED"},{"key":"idris","status":"CONFIRMED"},{"key":"faris","status":"CONFIRMED"},{"key":"shaz","status":"CONFIRMED"},{"key":"adam","status":"CONFIRMED"},{"key":"efat","status":"CONFIRMED"},{"key":"usama","status":"CONFIRMED"},{"key":"karahan","status":"CONFIRMED"}],"lastBotPost":"Got it 🙌 Pending — waiting for confirmation: Faris Nasser, Shaz Iqbal. Say the word and I'll loc